---
import Layout from '../../layouts/Layout.astro';
import CTASection from '../../components/CTASection.astro';
import { getAllPosts, getSite, getSurfaceStyle, resolveTextStyle, formatRich, type BlogPostData } from '../../lib/content';

export function getStaticPaths() {
  const posts = getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPostData;
}

const { post } = Astro.props;
const site = getSite();
const heroSt = getSurfaceStyle(post.heroStyle || 'platinum');
const metaColor = post.heroStyle === 'dustGrey' ? 'text-paletteRichBlack/70' : 'text-brandAccent';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": post.seo?.schemaType || "BlogPosting",
  "headline": post.seo?.headline || post.articleTitle || post.title,
  "description": post.seo?.schemaDesc || post.desc,
  "datePublished": post.datePublishedIso || "2026-11-10T09:00:00+03:00",
  "dateModified": post.datePublishedIso || "2026-11-10T09:00:00+03:00",
  "author": {
    "@type": "Organization",
    "name": site.brand.name,
    "url": site.brand.siteUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": site.brand.name,
    "url": site.brand.siteUrl
  }
};
const BlogHeroTag = (['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'p', 'div'].includes(post.headingTag || '') ? post.headingTag : 'h1') as any;

const blogHeroStyle = resolveTextStyle(post, 'title') || resolveTextStyle(post, 'heading');
const blogDescStyle = resolveTextStyle(post, 'desc');
---

<Layout
  title={post.seo?.title || `${post.title} | cx2222 Blog`}
  description={post.seo?.description || post.desc}
  seo={post.seo}
  image={post.heroImage || post.image}
  type="article"
  schema={articleSchema}
  breadcrumbs={[
    { name: "Blog", url: "/blog" },
    { name: post.seo?.breadcrumbName || post.title, url: `/blog/${post.slug}` }
  ]}
>
  
  <section class={`px-6 md:px-16 pt-[82px] md:pt-[114px] pb-16 md:pb-24 ${heroSt.section}`}>
    <div class="max-w-custom mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 space-y-6">
        <div class={`flex items-center gap-4 typo-small font-semibold tracking-widest ${metaColor}`}>
          <span set:html={formatRich(post.category)}></span>
          <span>•</span>
          <span>{post.date}</span>
          <span>•</span>
          <span set:html={formatRich(post.readTime)}></span>
        </div>
        <BlogHeroTag class={`typo-h1 ${heroSt.title}`} style={blogHeroStyle || undefined} set:html={formatRich(post.articleTitle || post.title)} />
        <p class={`typo-lead font-light ${heroSt.body}`} style={blogDescStyle || undefined} set:html={formatRich(post.articleSubtitle || post.desc)} />
      </div>
      <div class={`lg:col-span-5 aspect-[4/3] overflow-hidden ${post.heroStyle === 'richBlack' ? 'bg-neutral-800' : 'bg-neutral-200'}`}>
        <img 
          src={post.heroImage || post.image} 
          alt={post.imageAlt || post.title} 
          class="w-full h-full object-cover grayscale contrast-125"
        />
      </div>
    </div>
  </section>

  <article class="section-pad-150 bg-siteBg text-paletteRichBlack px-6 md:px-16">
    <div class="max-w-3xl mx-auto space-y-8 typo-body text-paletteRichBlack/80 font-light">
      
      {post.content && (
        <div class="prose max-w-none space-y-6 typo-body text-paletteRichBlack/80 font-light" set:html={typeof post.content === 'string' ? post.content : post.content.join('\n\n')}></div>
      )}

      {(post.blocks || []).map((block) => (
        block.type === 'heading' ? (
          <h2 class="typo-h2 text-paletteRichBlack pt-4" set:html={formatRich(block.text)}>
          </h2>
        ) : block.type === 'paragraph' ? (
          <p set:html={formatRich(block.text)}></p>
        ) : block.type === 'calloutList' ? (
          <div class="p-8 md:p-10 bg-palettePlatinum my-8 space-y-4">
            {block.title && <h3 class="typo-h3 text-paletteRichBlack" set:html={formatRich(block.title)}></h3>}
            <ul class="space-y-2 typo-body font-light text-paletteRichBlack/80">
              {(block.items || []).map((item) => (
                <li set:html={`• ${formatRich(item)}`}></li>
              ))}
            </ul>
          </div>
        ) : block.type === 'gridCards' ? (
          <div class={`grid grid-cols-1 ${block.cards && block.cards.length >= 4 ? 'sm:grid-cols-2 gap-4' : 'md:grid-cols-2 gap-0'} my-6`}>
            {(block.cards || []).map((c) => {
              const st = getSurfaceStyle(c.style || 'platinum');
              return (
                <div class={`${block.gap === 'gap-4' ? 'p-6' : 'p-8'} space-y-2 ${st.section}`}>
                  <h3 class={`typo-h4 mb-1 ${st.cardTitle}`} set:html={formatRich(c.title)}></h3>
                  <p class={`typo-small font-light ${st.cardBody}`} set:html={formatRich(c.body)}></p>
                </div>
              );
            })}
          </div>
        ) : null
      ))}

      <div class="pt-12 mt-12 flex flex-wrap items-center justify-between gap-4">
        <a href="/blog" class="btn-rect text-sm font-medium text-paletteRichBlack hover:text-brandAccent">
          ← Tüm Makalelere Dön
        </a>
        {post.relatedLink && (
          <a href={post.relatedLink.href} class="btn-rect text-sm font-medium text-brandAccent hover:text-paletteRichBlack" set:html={formatRich(post.relatedLink.label)}>
          </a>
        )}
      </div>

    </div>
  </article>

  <CTASection />

</Layout>
