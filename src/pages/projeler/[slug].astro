---
import Layout from '../../layouts/Layout.astro';
import CTASection from '../../components/CTASection.astro';
import BlogShowcaseBlock from '../../components/blocks/BlogShowcaseBlock.astro';
import { getAllProjects, getSite, getSurfaceStyle, resolveTextStyle, resolveTextTag, formatRich, type ProjectData } from '../../lib/content';

export function getStaticPaths() {
  const projects = getAllProjects();
  const paths: any[] = [];
  const aliasMap: Record<string, string> = {
    'istanbul-havalimani': 'iga-turk-misafirperverligi',
    'aksigorta-konut-sigortasi': 'aksigorta-yeni-konut-sigortasi',
    'fiat-surucu-dostu': 'fiat-surucu-dostu-hizmetler',
    'garanti-bbva-yatirim': 'garanti-bbva-kucuk-yatirimcilar',
    'offline-bahisciler': 'bilyoner',
  };
  for (const project of projects) {
    paths.push({
      params: { slug: project.slug },
      props: { project },
    });
    for (const [oldSlug, newSlug] of Object.entries(aliasMap)) {
      if (project.slug === newSlug) {
        paths.push({
          params: { slug: oldSlug },
          props: { project },
        });
      }
    }
  }
  return paths;
}

interface Props {
  project: ProjectData;
}

const { project } = Astro.props;
const site = getSite();
const activeHeroStyle = project.heroStyle || 'siteBg';
const heroSt = getSurfaceStyle(activeHeroStyle);
const heroEyebrowColor = activeHeroStyle === 'brandAccent' ? heroSt.title : 'text-brandAccent';
const backBtnClasses: Record<string, string> = {
  siteBg: 'bg-palettePlatinum text-paletteRichBlack hover:bg-paletteRichBlack hover:text-white',
  platinum: 'bg-siteBg text-paletteRichBlack hover:bg-paletteRichBlack hover:text-white',
  dustGrey: 'bg-siteBg text-paletteRichBlack hover:bg-paletteRichBlack hover:text-white',
  brandAccent: 'bg-paletteRichBlack text-white hover:bg-siteBg hover:text-paletteRichBlack',
  richBlack: 'bg-white/10 text-white hover:bg-brandAccent hover:text-paletteRichBlack',
};
const heroBackBtnClass = backBtnClasses[activeHeroStyle] || backBtnClasses.siteBg;
const ProjHeroTag = (['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'p', 'div'].includes(project.headingTag || '') ? project.headingTag : 'h1') as any;

const projHeroStyle = resolveTextStyle(project, 'title') || resolveTextStyle(project, 'heading');
const projDescStyle = resolveTextStyle(project, 'desc');
const clientStyle = resolveTextStyle(project, 'client') || resolveTextStyle(project, 'brand');

const rawChallengeTag = resolveTextTag(project.challenge, 'title', 'h2');
const ChallengeTag = (['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'p', 'div'].includes(rawChallengeTag) ? rawChallengeTag : 'h2') as any;
const challengeEyebrowStyle = resolveTextStyle(project.challenge, 'eyebrow');
const challengeTitleStyle = resolveTextStyle(project.challenge, 'title');
const challengeBodyStyle = resolveTextStyle(project.challenge, 'body');

const rawSolutionTag = resolveTextTag(project.solution, 'title', 'h2');
const SolutionTag = (['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'p', 'div'].includes(rawSolutionTag) ? rawSolutionTag : 'h2') as any;
const solutionEyebrowStyle = resolveTextStyle(project.solution, 'eyebrow');
const solutionTitleStyle = resolveTextStyle(project.solution, 'title');

const validMetrics = (project.metrics || []).filter((m: any) => m && (String(m.value || '').trim() || String(m.label || '').trim()));
const hasMetrics = validMetrics.length > 0;
const metricsGridClass = validMetrics.length === 1
  ? 'grid grid-cols-1 max-w-sm mx-auto text-center'
  : validMetrics.length === 2
  ? 'grid grid-cols-1 sm:grid-cols-2 gap-8 md:gap-16 w-full'
  : validMetrics.length === 3
  ? 'grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-10 w-full'
  : 'grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 w-full';
const hasSummary = Boolean(project.summaryItems && project.summaryItems.length > 0);
const hasChallenge = Boolean(project.challenge && (project.challenge.title || project.challenge.body));

const caseSchema = {
  "@context": "https://schema.org",
  "@type": project.seo?.schemaType || "Article",
  "headline": project.seo?.headline || `${project.client} - ${project.title}`,
  "description": project.seo?.schemaDesc || project.desc,
  "author": {
    "@type": "Organization",
    "name": site.brand.name
  },
  "publisher": {
    "@type": "Organization",
    "name": site.brand.name,
    "url": site.brand.siteUrl
  }
};
---

<Layout
  title={project.seo?.title || `${project.client} | ${project.title} | CX Folks`}
  description={project.seo?.description || project.desc}
  seo={project.seo}
  image={project.image}
  type="article"
  schema={caseSchema}
  breadcrumbs={[
    { name: "Projeler", url: "/projeler" },
    { name: project.seo?.breadcrumbName || project.client, url: `/projeler/${project.slug}` }
  ]}
>
  
  <!-- Header Banner -->
  <section class={`px-6 md:px-16 pt-[82px] md:pt-[114px] pb-16 md:pb-24 overflow-hidden ${heroSt.section}`}>
    <div class="max-w-custom mx-auto">
      <div class="mb-8 md:mb-10">
        <a
          href="/projeler"
          class="pill-outline-btn group w-max"
        >
          <span class="inline-block transition-transform duration-300 group-hover:-translate-x-1" aria-hidden="true">←</span>
          <span>Tüm Projeler</span>
        </a>
      </div>

      <div class="mb-4 typo-small font-semibold tracking-widest">
        {project.client && (
          <span class="project-client uppercase text-paletteRichBlack/70 font-semibold" style={clientStyle || undefined} set:html={formatRich(project.client || '')}></span>
        )}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-start">
        <div class="lg:col-span-6">
          <ProjHeroTag class={`typo-h1 ${heroSt.title}`} style={projHeroStyle || undefined} set:html={formatRich(project.title)} />
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class={`typo-lead font-light ${heroSt.body} space-y-4`} style={projDescStyle || undefined} set:html={formatRich(project.desc)} />
        </div>
      </div>

      <div class="mt-10 md:mt-14 w-full">
        <div class="w-full aspect-[4/3] sm:aspect-[16/9] lg:aspect-[21/9] bg-palettePlatinum overflow-hidden">
          <img 
            src={project.image} 
            alt={project.imageAlt || project.title} 
            class="w-full h-full block object-cover"
          />
        </div>
        {hasMetrics && (
          <div class="w-full bg-paletteRichBlack text-white px-6 md:px-12 py-8 md:py-12">
            <div class={metricsGridClass}>
              {validMetrics.map((m: any) => (
                <div class="w-full text-left">
                  <span class="text-3xl md:text-4xl font-light text-brandAccent block mb-1" style={resolveTextStyle(m, 'value') || undefined}>{m.value}</span>
                  <span class="typo-small tracking-wider text-white/70" style={resolveTextStyle(m, 'label') || undefined}>{m.label}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- 3. Bölüm: Tek Kolon Dar Alan (Kutu İçinde Soru, Yaklaşımımız ve 2. / 3. Görseller) -->
  <section class="px-6 md:px-16 py-12 md:py-16 bg-siteBg text-paletteRichBlack">
    <div class="max-w-3xl mx-auto space-y-12">
      
      <!-- Kutu İçinde Soru (Açık Zemin Cool Blue, Border Yok, Masaüstü 20px) -->
      {hasChallenge && (
        <div class="bg-[#D7EFFF] text-paletteRichBlack p-8 md:p-12 rounded-none space-y-3 challenge-box">
          {project.challenge?.eyebrow && String(project.challenge.eyebrow).trim() !== '' && (
            <span class="typo-small font-bold uppercase tracking-wider text-paletteRichBlack/60 block" style={challengeEyebrowStyle || undefined} set:html={formatRich(project.challenge.eyebrow)}></span>
          )}
          {project.challenge?.title && String(project.challenge.title).trim() !== '' && (
            <ChallengeTag class="!text-[18px] md:!text-[20px] font-normal leading-snug text-paletteRichBlack !text-wrap-normal" style={`font-size: clamp(18px, 1.5vw, 20px) !important; text-wrap: normal !important; ${challengeTitleStyle || ''}`} set:html={formatRich(project.challenge.title)}>
            </ChallengeTag>
          )}
          {project.challenge?.body && String(project.challenge.body).trim() !== '' && (
            <div class="typo-body !text-[16px] md:!text-[20px] text-paletteRichBlack/80 font-light leading-relaxed mt-3 !text-wrap-normal space-y-4" style={`text-wrap: normal !important; ${challengeBodyStyle || ''}`} set:html={formatRich(project.challenge.body)}>
            </div>
          )}
        </div>
      )}

      <!-- Yaklaşımımız Metni (Tek Kolonda Akıyor) -->
      {project.approach && String(project.approach).trim() !== '' && (
        <div class="prose-project typo-body font-light text-paletteRichBlack/85 leading-relaxed space-y-6" set:html={project.approach}></div>
      )}

      <!-- 2. ve 3. Görseller (Bordersız, Renkli, object-contain) -->
      {(project.image2 || project.image3) && (
        <div class="space-y-8 pt-4">
          {project.image2 && (
            <div class="w-full bg-[#fcfcfc] p-4 md:p-6 flex items-center justify-center overflow-hidden">
              <img src={project.image2} alt={project.image2Alt || `${project.title} Görsel 2`} class="max-h-[500px] w-auto object-contain" />
            </div>
          )}
          {project.image3 && (
            <div class="w-full bg-[#fcfcfc] p-4 md:p-6 flex items-center justify-center overflow-hidden">
              <img src={project.image3} alt={project.image3Alt || `${project.title} Görsel 3`} class="max-h-[500px] w-auto object-contain" />
            </div>
          )}
        </div>
      )}

    </div>
  </section>

  <!-- 4. Bölüm: Full-Width 2-Kolonlu Alan (Solda Çözümler & Çıktılar %50, Sağda ~1/3 Genişliğinde Ethnogram Koyu Kutusu) -->
  <section class="px-6 md:px-16 py-12 md:py-20 bg-siteBg text-paletteRichBlack">
    <div class="max-w-custom mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 relative">
        
        <!-- Sol Kolon (%50 Genişlik): Çözümler, Çıktılar, Operasyonel, Deneyim, Etkileri, Ödüller (Tek Zengin Metin Alanı) -->
        <div class="lg:col-span-6 prose-project typo-body font-light text-paletteRichBlack/85 leading-relaxed space-y-6">
          {project.content && String(project.content).trim() !== '' && (
            <div set:html={project.content}></div>
          )}
        </div>

        <!-- Sağ Kolon (~1/3 Genişlik): Ethnogram Stili Koyu Kutu (Plum Noir Zemin, Sticky, 20px Metin) -->
        <aside class="lg:col-span-5 lg:col-start-8 xl:col-span-4 xl:col-start-9 w-full relative">
          <div class="w-full bg-paletteRichBlack text-white p-8 md:p-10 sticky top-28 rounded-none space-y-6">
            <div class="text-[16px] md:text-[20px] font-light text-white leading-relaxed" set:html={formatRich(project.closingBoxText || project.quote || '')}>
            </div>
          </div>
        </aside>

      </div>
    </div>
  </section>

  {project.blogShowcase?.visible && (
    <BlogShowcaseBlock data={project.blogShowcase} style={{ surface: project.blogShowcase.surface || 'platinum' }} />
  )}

  <CTASection {...project.cta} visible={project.cta?.visible !== false} />

</Layout>

<style>
  :global(.prose-project h2) {
    font-size: var(--fs-h2, clamp(1.75rem, 3.5vw, 2.375rem));
    line-height: var(--lh-h2, 1.2);
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--color-text-main, #111111);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  :global(.prose-project h2:first-child) {
    margin-top: 0;
  }
  :global(.prose-project h3) {
    font-size: var(--fs-h3, clamp(1.25rem, 2.5vw, 1.625rem));
    line-height: var(--lh-h3, 1.3);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-text-main, #111111);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  :global(.prose-project p) {
    font-size: var(--fs-body, 1rem);
    line-height: var(--lh-body, 1.65);
    font-weight: 300;
    color: rgba(17, 17, 17, 0.85);
    margin-bottom: 1.25rem;
  }
  :global(.prose-project ul) {
    list-style-type: disc;
    padding-left: 1.25rem;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  :global(.prose-project li) {
    font-size: var(--fs-body, 1rem);
    line-height: var(--lh-body, 1.65);
    font-weight: 300;
    color: rgba(17, 17, 17, 0.85);
  }
  :global(.prose-project strong), :global(.prose-project b) {
    font-weight: 600;
    color: var(--color-text-main, #111111);
  }
  :global(.prose-project a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :global(.prose-project a:hover) {
    color: var(--brand-accent, #E9F056);
  }
  :global(.prose-project blockquote) {
    border-left: 3px solid var(--brand-accent, #E9F056);
    padding: 1rem 1.5rem;
    background: #f0f0f0;
    margin: 1.5rem 0;
    font-style: italic;
  }
</style>
