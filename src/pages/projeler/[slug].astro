---
import Layout from '../../layouts/Layout.astro';
import CTASection from '../../components/CTASection.astro';
import BlogShowcaseBlock from '../../components/blocks/BlogShowcaseBlock.astro';
import { getAllProjects, getSite, getSurfaceStyle, resolveTextStyle, resolveTextTag, formatRich, type ProjectData } from '../../lib/content';

export function getStaticPaths() {
  const projects = getAllProjects();
  const paths: any[] = [];
  const aliasMap: Record<string, string> = {
    'istanbul-havalimani': 'iga-turk-misafirperverligi',
    'aksigorta-konut-sigortasi': 'aksigorta-yeni-konut-sigortasi',
    'fiat-surucu-dostu': 'fiat-surucu-dostu-hizmetler',
    'garanti-bbva-yatirim': 'garanti-bbva-kucuk-yatirimcilar',
    'offline-bahisciler': 'bilyoner',
  };
  for (const project of projects) {
    paths.push({
      params: { slug: project.slug },
      props: { project },
    });
    for (const [oldSlug, newSlug] of Object.entries(aliasMap)) {
      if (project.slug === newSlug) {
        paths.push({
          params: { slug: oldSlug },
          props: { project },
        });
      }
    }
  }
  return paths;
}

interface Props {
  project: ProjectData;
}

const { project } = Astro.props;
const site = getSite();
const activeHeroStyle = project.heroStyle || 'siteBg';
const heroSt = getSurfaceStyle(activeHeroStyle);
const heroEyebrowColor = activeHeroStyle === 'brandAccent' ? heroSt.title : 'text-brandAccent';
const backBtnClasses: Record<string, string> = {
  siteBg: 'bg-palettePlatinum text-paletteRichBlack hover:bg-paletteRichBlack hover:text-white',
  platinum: 'bg-siteBg text-paletteRichBlack hover:bg-paletteRichBlack hover:text-white',
  dustGrey: 'bg-siteBg text-paletteRichBlack hover:bg-paletteRichBlack hover:text-white',
  brandAccent: 'bg-paletteRichBlack text-white hover:bg-siteBg hover:text-paletteRichBlack',
  richBlack: 'bg-white/10 text-white hover:bg-brandAccent hover:text-paletteRichBlack',
};
const heroBackBtnClass = backBtnClasses[activeHeroStyle] || backBtnClasses.siteBg;
const ProjHeroTag = (['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'p', 'div'].includes(project.headingTag || '') ? project.headingTag : 'h1') as any;

const projHeroStyle = resolveTextStyle(project, 'title') || resolveTextStyle(project, 'heading');
const projDescStyle = resolveTextStyle(project, 'desc');
const clientStyle = resolveTextStyle(project, 'client') || resolveTextStyle(project, 'brand');

const rawChallengeTag = resolveTextTag(project.challenge, 'title', 'h2');
const ChallengeTag = (['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'p', 'div'].includes(rawChallengeTag) ? rawChallengeTag : 'h2') as any;
const challengeEyebrowStyle = resolveTextStyle(project.challenge, 'eyebrow');
const challengeTitleStyle = resolveTextStyle(project.challenge, 'title');
const challengeBodyStyle = resolveTextStyle(project.challenge, 'body');

const rawSolutionTag = resolveTextTag(project.solution, 'title', 'h2');
const SolutionTag = (['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'p', 'div'].includes(rawSolutionTag) ? rawSolutionTag : 'h2') as any;
const solutionEyebrowStyle = resolveTextStyle(project.solution, 'eyebrow');
const solutionTitleStyle = resolveTextStyle(project.solution, 'title');

const validMetrics = (project.metrics || []).filter((m: any) => m && (String(m.value || '').trim() || String(m.label || '').trim()));
const hasMetrics = validMetrics.length > 0;
const hasSummary = Boolean(project.summaryItems && project.summaryItems.length > 0);
const hasChallenge = Boolean(project.challenge && (project.challenge.title || project.challenge.body));

const caseSchema = {
  "@context": "https://schema.org",
  "@type": project.seo?.schemaType || "Article",
  "headline": project.seo?.headline || `${project.client} - ${project.title}`,
  "description": project.seo?.schemaDesc || project.desc,
  "author": {
    "@type": "Organization",
    "name": site.brand.name
  },
  "publisher": {
    "@type": "Organization",
    "name": site.brand.name,
    "url": site.brand.siteUrl
  }
};
---

<Layout
  title={project.seo?.title || `${project.client} | ${project.title} | CX Folks`}
  description={project.seo?.description || project.desc}
  seo={project.seo}
  image={project.image}
  type="article"
  schema={caseSchema}
  breadcrumbs={[
    { name: "Projeler", url: "/projeler" },
    { name: project.seo?.breadcrumbName || project.client, url: `/projeler/${project.slug}` }
  ]}
>
  
  <!-- Header Banner -->
  <section class={`px-6 md:px-16 pt-[82px] md:pt-[114px] pb-16 md:pb-24 overflow-hidden ${heroSt.section}`}>
    <div class="max-w-custom mx-auto">
      <div class="mb-8 md:mb-10">
        <a
          href="/projeler"
          class={`btn-rect w-max min-h-[2.75rem] px-5 py-2.5 font-medium transition-colors ${heroBackBtnClass}`}
        >
          ← Tüm Projeler
        </a>
      </div>

      <div class="mb-4 typo-small font-semibold tracking-widest flex flex-wrap items-center gap-x-3">
        {project.client && (
          <span class={`project-client uppercase ${clientStyle ? '' : heroEyebrowColor}`} style={clientStyle || undefined} set:html={formatRich(project.client || '')}></span>
        )}
        {project.sector && (
          <span class="project-sector opacity-70 font-normal" style={resolveTextStyle(project, 'sector') || undefined} set:html={formatRich(project.sector)}></span>
        )}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-center">
        <div class="lg:col-span-6">
          <ProjHeroTag class={`typo-h1 ${heroSt.title}`} style={projHeroStyle || undefined} set:html={formatRich(project.title)} />
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <p class={`typo-lead font-light ${heroSt.body}`} style={projDescStyle || undefined} set:html={formatRich(project.desc)} />
        </div>
      </div>

      <div class="mt-10 md:mt-14 w-full">
        <div class="w-full aspect-[4/3] sm:aspect-[16/9] lg:aspect-[21/9] bg-palettePlatinum overflow-hidden">
          <img 
            src={project.image} 
            alt={project.imageAlt || project.title} 
            class="w-full h-full block object-cover grayscale contrast-125"
          />
        </div>
        {hasMetrics && (
          <div class="w-full bg-paletteRichBlack text-white px-6 md:px-12 py-8 md:py-12">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
              {validMetrics.map((m: any) => (
                <div>
                  <span class="text-3xl md:text-4xl font-light text-brandAccent block mb-1" style={resolveTextStyle(m, 'value') || undefined}>{m.value}</span>
                  <span class="typo-small tracking-wider text-white/70" style={resolveTextStyle(m, 'label') || undefined}>{m.label}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Soru Bölümü (Question Callout) -->
  {hasChallenge && (
    <section class="px-6 md:px-16 pt-12 md:pt-16 pb-0 bg-siteBg">
      <div class="max-w-custom mx-auto">
        <div class="bg-palettePlatinum p-8 md:p-12 border-l-4 border-brandAccent">
          {project.challenge?.eyebrow && String(project.challenge.eyebrow).trim() !== '' && (
            <span class="typo-small font-bold uppercase tracking-widest text-brandAccent block mb-3" style={challengeEyebrowStyle || undefined} set:html={formatRich(project.challenge.eyebrow)}></span>
          )}
          {project.challenge?.title && String(project.challenge.title).trim() !== '' && (
            <ChallengeTag class="typo-h2 text-paletteRichBlack" style={challengeTitleStyle || undefined} set:html={formatRich(project.challenge.title)}>
            </ChallengeTag>
          )}
          {project.challenge?.body && String(project.challenge.body).trim() !== '' && (
            <p class="typo-body text-paletteRichBlack/75 font-light mt-4" style={challengeBodyStyle || undefined} set:html={formatRich(project.challenge.body)}>
            </p>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Görsel 2 ve 3 -->
  {(project.image2 || project.image3) && (
    <section class="px-6 md:px-16 pt-10 md:pt-14 pb-0 bg-siteBg">
      <div class="max-w-custom mx-auto">
        <div class={`grid grid-cols-1 ${project.image2 && project.image3 ? 'md:grid-cols-2' : 'grid-cols-1'} gap-6 md:gap-8`}>
          {project.image2 && (
            <div class="w-full aspect-[16/10] bg-palettePlatinum overflow-hidden">
              <img src={project.image2} alt={project.image2Alt || `${project.title} Görsel 2`} class="w-full h-full object-cover grayscale contrast-125" />
            </div>
          )}
          {project.image3 && (
            <div class="w-full aspect-[16/10] bg-palettePlatinum overflow-hidden">
              <img src={project.image3} alt={project.image3Alt || `${project.title} Görsel 3`} class="w-full h-full object-cover grayscale contrast-125" />
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- 2 Kolonlu İçerik ve Gri Kutu Özeti -->
  <section class="px-6 md:px-16 pt-12 md:pt-16 pb-24 md:pb-36 bg-siteBg text-paletteRichBlack">
    <div class="max-w-custom mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        
        <!-- Sol Kolon: Zengin Metin (Rich Text) & Alıntı -->
        <div class={`${hasSummary ? 'lg:col-span-8' : 'lg:col-span-12 max-w-4xl'} space-y-8`}>
          {project.content && String(project.content).trim() !== '' && (
            <div class="prose-project typo-body font-light text-paletteRichBlack/85 leading-relaxed" style={resolveTextStyle(project, 'content') || undefined} set:html={project.content}></div>
          )}

          {project.quote && String(project.quote).trim() !== '' && (
            <div class="p-8 md:p-12 bg-palettePlatinum border-l-2 border-brandAccent italic text-lg md:text-xl text-paletteRichBlack/90 font-light leading-relaxed my-8" style={resolveTextStyle(project, 'quote') || undefined} set:html={formatRich(project.quote)}>
            </div>
          )}
        </div>

        <!-- Sağ Kolon: Ethnogram Stili Gri Kutu Özeti -->
        {hasSummary && (
          <aside class="lg:col-span-4">
            <div class="sticky top-28 bg-palettePlatinum p-6 md:p-8 space-y-8 border-t-2 md:border-t-0 border-paletteRichBlack/10">
              <div class="border-b border-paletteRichBlack/10 pb-4">
                <span class="typo-small font-bold uppercase tracking-widest text-paletteRichBlack/60 block">Proje Özeti & Çıktılar</span>
              </div>
              <div class="space-y-6">
                {project.summaryItems?.map((item: any) => (
                  <div class="space-y-2">
                    <h4 class="typo-small font-bold uppercase tracking-wider text-paletteRichBlack" set:html={formatRich(item.title)}></h4>
                    <p class="typo-small text-paletteRichBlack/80 font-light leading-relaxed whitespace-pre-line" set:html={formatRich(item.body)}></p>
                  </div>
                ))}
              </div>
            </div>
          </aside>
        )}

      </div>
    </div>
  </section>

  {project.blogShowcase?.visible && (
    <BlogShowcaseBlock data={project.blogShowcase} style={{ surface: project.blogShowcase.surface || 'platinum' }} />
  )}

  <CTASection {...project.cta} visible={project.cta?.visible !== false} />

</Layout>

<style>
  :global(.prose-project h2) {
    font-size: 1.75rem;
    line-height: 2.125rem;
    font-weight: 300;
    letter-spacing: -0.02em;
    color: #111111;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  @media (min-width: 768px) {
    :global(.prose-project h2) {
      font-size: 2.125rem;
      line-height: 2.5rem;
    }
  }
  :global(.prose-project h2:first-child) {
    margin-top: 0;
  }
  :global(.prose-project h3) {
    font-size: 1.25rem;
    line-height: 1.625rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: #111111;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  @media (min-width: 768px) {
    :global(.prose-project h3) {
      font-size: 1.5rem;
      line-height: 1.875rem;
    }
  }
  :global(.prose-project p) {
    font-size: 1rem;
    line-height: 1.75rem;
    font-weight: 300;
    color: rgba(17, 17, 17, 0.85);
    margin-bottom: 1.25rem;
  }
  :global(.prose-project ul) {
    list-style-type: disc;
    padding-left: 1.25rem;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  :global(.prose-project li) {
    font-size: 1rem;
    line-height: 1.625rem;
    font-weight: 300;
    color: rgba(17, 17, 17, 0.85);
  }
  :global(.prose-project strong), :global(.prose-project b) {
    font-weight: 600;
    color: #111111;
  }
  :global(.prose-project a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :global(.prose-project a:hover) {
    color: var(--brand-accent, #E9F056);
  }
  :global(.prose-project blockquote) {
    border-left: 3px solid var(--brand-accent, #E9F056);
    padding: 1rem 1.5rem;
    background: #f0f0f0;
    margin: 1.5rem 0;
    font-style: italic;
  }
</style>
