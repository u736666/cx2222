---
import Layout from '../../layouts/Layout.astro';
import CTASection from '../../components/CTASection.astro';
import BlogShowcaseBlock from '../../components/blocks/BlogShowcaseBlock.astro';
import { getAllProjects, getSite, getSurfaceStyle, resolveTextStyle, formatRich, type ProjectData } from '../../lib/content';

export function getStaticPaths() {
  const projects = getAllProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: ProjectData;
}

const { project } = Astro.props;
const site = getSite();
const activeHeroStyle = project.heroStyle || 'siteBg';
const heroSt = getSurfaceStyle(activeHeroStyle);
const heroEyebrowColor = activeHeroStyle === 'brandAccent' ? heroSt.title : 'text-brandAccent';
const backBtnClasses: Record<string, string> = {
  siteBg: 'bg-palettePlatinum text-paletteRichBlack hover:bg-paletteRichBlack hover:text-white',
  platinum: 'bg-siteBg text-paletteRichBlack hover:bg-paletteRichBlack hover:text-white',
  dustGrey: 'bg-siteBg text-paletteRichBlack hover:bg-paletteRichBlack hover:text-white',
  brandAccent: 'bg-paletteRichBlack text-white hover:bg-siteBg hover:text-paletteRichBlack',
  richBlack: 'bg-white/10 text-white hover:bg-brandAccent hover:text-paletteRichBlack',
};
const heroBackBtnClass = backBtnClasses[activeHeroStyle] || backBtnClasses.siteBg;
const ProjHeroTag = (['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'p', 'div'].includes(project.headingTag || '') ? project.headingTag : 'h1') as any;

const projHeroStyle = resolveTextStyle(project, 'title') || resolveTextStyle(project, 'heading');
const projDescStyle = resolveTextStyle(project, 'desc');
const clientStyle = resolveTextStyle(project, 'client') || resolveTextStyle(project, 'brand');

const validMetrics = (project.metrics || []).filter((m: any) => m && (String(m.value || '').trim() || String(m.label || '').trim()));
const hasMetrics = validMetrics.length > 0;

const img2Pos = project.image2Position || 'afterChallenge';
const img3Pos = project.image3Position || 'afterSolution';

const caseSchema = {
  "@context": "https://schema.org",
  "@type": project.seo?.schemaType || "Article",
  "headline": project.seo?.headline || `${project.client} - ${project.title}`,
  "description": project.seo?.schemaDesc || project.desc,
  "author": {
    "@type": "Organization",
    "name": site.brand.name
  },
  "publisher": {
    "@type": "Organization",
    "name": site.brand.name,
    "url": site.brand.siteUrl
  }
};
---

<Layout
  title={project.seo?.title || `${project.client} | ${project.title} | cx2222`}
  description={project.seo?.description || project.desc}
  seo={project.seo}
  image={project.image}
  type="article"
  schema={caseSchema}
  breadcrumbs={[
    { name: "Projeler", url: "/projeler" },
    { name: project.seo?.breadcrumbName || project.client, url: `/projeler/${project.slug}` }
  ]}
>
  
  <!-- Header Banner -->
  <section class={`px-6 md:px-16 pt-[82px] md:pt-[114px] pb-16 md:pb-24 overflow-hidden ${heroSt.section}`}>
    <div class="max-w-custom mx-auto">
      <div class="mb-8 md:mb-10">
        <a
          href="/projeler"
          class={`btn-rect w-max min-h-[2.75rem] px-5 py-2.5 font-medium transition-colors ${heroBackBtnClass}`}
        >
          ← Tüm Projeler
        </a>
      </div>

      <div class="mb-4 typo-small font-semibold tracking-widest flex flex-wrap items-center gap-x-3">
        <span class={`project-client uppercase ${clientStyle ? '' : heroEyebrowColor}`} style={clientStyle || undefined} set:html={formatRich(project.client || '')}></span>
        {project.sector && (
          <span class="project-sector opacity-70 font-normal" set:html={formatRich(project.sector)}></span>
        )}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-center">
        <div class="lg:col-span-6">
          <ProjHeroTag class={`typo-h1 ${heroSt.title}`} style={projHeroStyle || undefined} set:html={formatRich(project.title)} />
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <p class={`typo-lead font-light ${heroSt.body}`} style={projDescStyle || undefined} set:html={formatRich(project.desc)} />
        </div>
      </div>

      <div class="mt-10 md:mt-14 w-full aspect-[4/3] sm:aspect-[16/9] lg:aspect-[21/9] bg-palettePlatinum overflow-hidden">
        <img 
          src={project.image} 
          alt={project.imageAlt || project.title} 
          class="w-full h-full block object-cover grayscale contrast-125"
        />
      </div>
    </div>
  </section>

  <!-- Metrikler -->
  {hasMetrics && (
    <section class="bg-paletteRichBlack text-white px-6 md:px-16 py-16">
      <div class="max-w-custom mx-auto grid grid-cols-2 md:grid-cols-4 gap-8">
        {validMetrics.map((m: any) => (
          <div>
            <span class="text-3xl md:text-4xl font-light text-brandAccent block mb-1">{m.value}</span>
            <span class="typo-small tracking-wider text-white/60">{m.label}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Narrative -->
  <section class={`${hasMetrics ? 'section-pad-150' : 'pt-12 md:pt-16 pb-24 md:pb-36'} bg-siteBg text-paletteRichBlack px-6 md:px-16`}>
    <div class="max-w-4xl mx-auto space-y-16">
      
      {project.content && (
        <div class="prose max-w-none space-y-6 typo-body text-paletteRichBlack/85 font-light" set:html={project.content}></div>
      )}

      {project.image2 && img2Pos === 'afterContent' && (
        <div class="w-full aspect-[16/9] sm:aspect-[21/9] bg-palettePlatinum overflow-hidden">
          <img src={project.image2} alt={project.image2Alt || `${project.title} Görsel 2`} class="w-full h-full object-cover grayscale contrast-125" />
        </div>
      )}
      {project.image3 && img3Pos === 'afterContent' && (
        <div class="w-full aspect-[16/9] sm:aspect-[21/9] bg-palettePlatinum overflow-hidden">
          <img src={project.image3} alt={project.image3Alt || `${project.title} Görsel 3`} class="w-full h-full object-cover grayscale contrast-125" />
        </div>
      )}

      {project.challenge && (
        <div class="space-y-4">
          <span class="typo-small font-bold tracking-widest text-brandAccent block">{project.challenge.eyebrow || 'Zorluk'}</span>
          <h2 class="typo-h2 text-paletteRichBlack" set:html={formatRich(project.challenge.title)}>
          </h2>
          <p class="typo-body text-paletteRichBlack/75 font-light" set:html={formatRich(project.challenge.body)}>
          </p>
        </div>
      )}

      {project.image2 && img2Pos === 'afterChallenge' && (
        <div class="w-full aspect-[16/9] sm:aspect-[21/9] bg-palettePlatinum overflow-hidden">
          <img src={project.image2} alt={project.image2Alt || `${project.title} Görsel 2`} class="w-full h-full object-cover grayscale contrast-125" />
        </div>
      )}
      {project.image3 && img3Pos === 'afterChallenge' && (
        <div class="w-full aspect-[16/9] sm:aspect-[21/9] bg-palettePlatinum overflow-hidden">
          <img src={project.image3} alt={project.image3Alt || `${project.title} Görsel 3`} class="w-full h-full object-cover grayscale contrast-125" />
        </div>
      )}

      {project.solution && project.solution.cards && project.solution.cards.length > 0 && (
        <div class="space-y-4">
          <span class="typo-small font-bold tracking-widest text-brandAccent block">{project.solution.eyebrow || 'Çözüm'}</span>
          <h2 class="typo-h2 text-paletteRichBlack" set:html={formatRich(project.solution.title)}>
          </h2>
          <div class={`grid grid-cols-1 ${project.solution.columns === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3'} gap-6 pt-4`}>
            {project.solution.cards.map((card) => {
              const cardSt = getSurfaceStyle(card.style || 'platinum');
              return (
                <div class={`p-8 ${cardSt.section}`}>
                  <h3 class={`typo-h3 mb-2 ${cardSt.cardTitle}`} set:html={formatRich(card.title)}></h3>
                  <p class={`typo-small font-light ${cardSt.cardBody}`} set:html={formatRich(card.body)}>
                  </p>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {project.image2 && img2Pos === 'afterSolution' && (
        <div class="w-full aspect-[16/9] sm:aspect-[21/9] bg-palettePlatinum overflow-hidden">
          <img src={project.image2} alt={project.image2Alt || `${project.title} Görsel 2`} class="w-full h-full object-cover grayscale contrast-125" />
        </div>
      )}
      {project.image3 && img3Pos === 'afterSolution' && (
        <div class="w-full aspect-[16/9] sm:aspect-[21/9] bg-palettePlatinum overflow-hidden">
          <img src={project.image3} alt={project.image3Alt || `${project.title} Görsel 3`} class="w-full h-full object-cover grayscale contrast-125" />
        </div>
      )}

      {project.quote && (
        <div class="p-10 md:p-14 bg-palettePlatinum italic text-lg md:text-2xl text-paletteRichBlack/85 font-light leading-relaxed" set:html={formatRich(project.quote)}>
        </div>
      )}

      {project.image2 && (img2Pos === 'afterQuote' || img2Pos === 'end') && (
        <div class="w-full aspect-[16/9] sm:aspect-[21/9] bg-palettePlatinum overflow-hidden">
          <img src={project.image2} alt={project.image2Alt || `${project.title} Görsel 2`} class="w-full h-full object-cover grayscale contrast-125" />
        </div>
      )}
      {project.image3 && (img3Pos === 'afterQuote' || img3Pos === 'end') && (
        <div class="w-full aspect-[16/9] sm:aspect-[21/9] bg-palettePlatinum overflow-hidden">
          <img src={project.image3} alt={project.image3Alt || `${project.title} Görsel 3`} class="w-full h-full object-cover grayscale contrast-125" />
        </div>
      )}

    </div>
  </section>

  {project.blogShowcase?.visible && (
    <BlogShowcaseBlock data={project.blogShowcase} style={{ surface: project.blogShowcase.surface || 'platinum' }} />
  )}

  <CTASection {...project.cta} visible={project.cta?.visible !== false} />

</Layout>
