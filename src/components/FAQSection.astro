---
import { formatRich } from '../lib/content';

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  headingTag?: string;
  items: FAQItem[];
  titleStyle?: string;
  subtitleStyle?: string;
}

const {
  title = "Sıkça Sorulan Sorular",
  subtitle,
  headingTag = "h2",
  items = [],
  titleStyle,
  subtitleStyle
} = Astro.props;

const HeadingTag = (['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'p', 'div'].includes(headingTag) ? headingTag : 'h2') as any;

const hasSubtitle = subtitle !== undefined && subtitle !== null && String(subtitle).trim() !== '';
const hasTitle = title !== undefined && title !== null && String(title).trim() !== '';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section class="section-pad-150 bg-palettePlatinum px-6 md:px-16">
  <div class="max-w-custom mx-auto">
    <div class="grid-standard items-start">
      
      <div class="col-span-12 lg:col-span-5 space-y-4 pr-0 lg:pr-10">
        {hasTitle && (
          <HeadingTag class="typo-h2 text-paletteRichBlack" style={titleStyle || undefined} set:html={formatRich(title)}>
          </HeadingTag>
        )}
      </div>

      <div class="col-span-12 lg:col-span-7 space-y-[2px]">
        {items.map((item) => (
          <details class="group bg-siteBg text-paletteRichBlack p-5 sm:p-6 cursor-pointer open:bg-paletteRichBlack open:text-white transition-colors duration-200">
            <summary class="flex items-center justify-between gap-4 list-none select-none [&::-webkit-details-marker]:hidden">
              <h3 class="accordion-title-var text-base sm:text-lg lg:text-[1.25rem] font-normal leading-snug group-open:text-white" set:html={formatRich(item.question)}>
              </h3>
              <span class="w-8 h-8 bg-palettePlatinum group-open:bg-white/10 group-open:text-white flex items-center justify-center text-paletteRichBlack text-sm flex-shrink-0 transition-colors">
                <span class="group-open:hidden">+</span>
                <span class="hidden group-open:inline">−</span>
              </span>
            </summary>
            <div class="mt-3 pt-3 text-sm sm:text-[0.9375rem] font-light leading-relaxed opacity-85 pr-[20%]" set:html={formatRich(item.answer)}>
            </div>
          </details>
        ))}
      </div>

    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
