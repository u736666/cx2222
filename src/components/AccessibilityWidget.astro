---
// AccessibilityWidget.astro — Dive-style floating accessibility menu
---

<div id="accessibility-widget" class="fixed bottom-4 right-4 z-50 print:hidden font-sans">
  <!-- Accessibility Popover Panel (TheDive Stili Köşeli, Mimari Tasarım) -->
  <div
    id="accessibility-panel"
    role="dialog"
    aria-label="Erişilebilirlik Menüsü"
    aria-hidden="true"
    class="hidden absolute bottom-14 right-0 w-64 sm:w-72 bg-white text-black border-2 border-black shadow-2xl rounded-none overflow-hidden transition-all duration-200 opacity-0 translate-y-2"
  >
    <!-- Header -->
    <div class="px-4 py-3 border-b border-neutral-200 flex items-center justify-between bg-white">
      <span class="font-bold text-[14px] text-black tracking-tight">Erişilebilirlik Menüsü</span>
      <div class="flex items-center gap-1">
        <button
          id="acc-reset-btn"
          type="button"
          title="Ayarları Sıfırla"
          aria-label="Ayarları Sıfırla"
          class="w-7 h-7 flex items-center justify-center text-neutral-600 hover:text-black hover:bg-neutral-100 transition-colors text-sm rounded-none"
        >
          ↺
        </button>
        <button
          id="acc-close-btn"
          type="button"
          title="Menüyü Kapat"
          aria-label="Menüyü Kapat"
          class="w-7 h-7 flex items-center justify-center text-neutral-600 hover:text-black hover:bg-neutral-100 transition-colors text-sm rounded-none"
        >
          ✕
        </button>
      </div>
    </div>

    <!-- Actions List (TheDive Birebir Yalın Liste Tasarımı) -->
    <div class="py-2 text-[14px]">
      <button
        id="acc-increase-font"
        type="button"
        class="w-full px-4 py-2.5 flex items-center gap-3 text-left hover:bg-neutral-100 transition-colors cursor-pointer group text-neutral-800 hover:text-black"
      >
        <span class="font-bold text-[13px] tracking-tighter w-5 text-center select-none text-black">TT</span>
        <span class="font-normal text-[14px]">Yazı Boyutunu Büyüt</span>
      </button>

      <button
        id="acc-decrease-font"
        type="button"
        class="w-full px-4 py-2.5 flex items-center gap-3 text-left hover:bg-neutral-100 transition-colors cursor-pointer group text-neutral-800 hover:text-black"
      >
        <span class="font-bold text-[12px] tracking-tighter w-5 text-center select-none text-black">T<span class="text-[9px]">T</span></span>
        <span class="font-normal text-[14px]">Yazı Boyutunu Küçült</span>
      </button>

      <button
        id="acc-contrast-toggle"
        type="button"
        class="w-full px-4 py-2.5 flex items-center gap-3 text-left hover:bg-neutral-100 transition-colors cursor-pointer group text-neutral-800 hover:text-black"
      >
        <span class="text-base w-5 text-center select-none text-black">◐</span>
        <span class="font-normal text-[14px]">Kontrast</span>
      </button>
    </div>
  </div>

  <!-- Floating Trigger Button (TheDive Stili: Saf Siyah Kare & Beyaz İkon, Sıfır Kenarlık) -->
  <button
    id="accessibility-trigger-btn"
    type="button"
    aria-expanded="false"
    aria-controls="accessibility-panel"
    aria-label="Erişilebilirlik Menüsünü Aç / Kapat"
    class="w-11 h-11 bg-black text-white hover:bg-neutral-800 flex items-center justify-center transition-all duration-200 focus:outline-none group rounded-none cursor-pointer shadow-md"
    style="border: none !important; outline: none !important; border-radius: 0 !important; box-shadow: none !important;"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256" class="w-5 h-5 transition-transform group-hover:scale-105">
      <path d="M100,36a28,28,0,1,1,28,28A28,28,0,0,1,100,36ZM227.6,92.57A15.7,15.7,0,0,0,212,80H44a16,16,0,0,0-6.7,30.53l.06,0,53.89,23.73-21.92,83.3a16,16,0,0,0,7.9,20.91A15.83,15.83,0,0,0,84,240a16,16,0,0,0,14.44-9.06L128,180l29.58,51a16,16,0,0,0,29.07-13.35l-21.92-83.3,54-23.76A15.7,15.7,0,0,0,227.6,92.57Z"></path>
    </svg>
  </button>
</div>

<script is:inline>
  (function() {
    const STORAGE_KEY = 'cxfolks_accessibility';
    let state = {
      fontScale: 1,
      contrast: false
    };

    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) state = Object.assign(state, JSON.parse(saved));
    } catch (e) {}

    function applyState() {
      // 1. Font scale via CSS root variable
      document.documentElement.style.setProperty('--acc-font-scale', state.fontScale);
      document.documentElement.style.fontSize = (state.fontScale * 100) + '%';

      // 2. High contrast mode
      if (state.contrast) {
        document.documentElement.classList.add('accessibility-high-contrast');
      } else {
        document.documentElement.classList.remove('accessibility-high-contrast');
      }

      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch (e) {}
    }

    // Run immediately on page load
    applyState();

    document.addEventListener('DOMContentLoaded', function() {
      const panel = document.getElementById('accessibility-panel');
      const triggerBtn = document.getElementById('accessibility-trigger-btn');
      const closeBtn = document.getElementById('acc-close-btn');
      const resetBtn = document.getElementById('acc-reset-btn');
      const incBtn = document.getElementById('acc-increase-font');
      const decBtn = document.getElementById('acc-decrease-font');
      const contrastBtn = document.getElementById('acc-contrast-toggle');

      if (!panel || !triggerBtn) return;

      function togglePanel(open) {
        const isHidden = panel.classList.contains('hidden');
        const shouldOpen = open !== undefined ? open : isHidden;

        if (shouldOpen) {
          panel.classList.remove('hidden');
          requestAnimationFrame(() => {
            panel.classList.remove('opacity-0', 'translate-y-2');
            panel.classList.add('opacity-100', 'translate-y-0');
          });
          panel.setAttribute('aria-hidden', 'false');
          triggerBtn.setAttribute('aria-expanded', 'true');
        } else {
          panel.classList.remove('opacity-100', 'translate-y-0');
          panel.classList.add('opacity-0', 'translate-y-2');
          panel.setAttribute('aria-hidden', 'true');
          triggerBtn.setAttribute('aria-expanded', 'false');
          setTimeout(() => {
            panel.classList.add('hidden');
          }, 200);
        }
      }

      triggerBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        togglePanel();
      });

      if (closeBtn) {
        closeBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          togglePanel(false);
        });
      }

      if (incBtn) {
        incBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          if (state.fontScale < 1.35) {
            state.fontScale = Math.round((state.fontScale + 0.1) * 10) / 10;
            applyState();
          }
        });
      }

      if (decBtn) {
        decBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          if (state.fontScale > 0.85) {
            state.fontScale = Math.round((state.fontScale - 0.1) * 10) / 10;
            applyState();
          }
        });
      }

      if (contrastBtn) {
        contrastBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          state.contrast = !state.contrast;
          applyState();
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          state.fontScale = 1;
          state.contrast = false;
          applyState();
        });
      }

      // Close when clicking outside
      document.addEventListener('click', function(e) {
        if (!panel.classList.contains('hidden')) {
          if (!panel.contains(e.target) && !triggerBtn.contains(e.target)) {
            togglePanel(false);
          }
        }
      });

      // Close on Esc
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && !panel.classList.contains('hidden')) {
          togglePanel(false);
        }
      });
    });
  })();
</script>
