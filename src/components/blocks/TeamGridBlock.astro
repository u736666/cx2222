---
import Heading from '../Heading.astro';
import { formatRich, resolvePaletteColor, resolveTextStyle, formatSizePx } from '../../lib/content';

interface TeamMember {
  id?: string;
  name: string;
  role: string;
  image?: string;
  isQuoteCard?: boolean;
  quote?: string;
  quoteAuthor?: string;
  bgColor?: string;
  linkedin?: string;
  twitter?: string;
  nameCase?: string;
  nameSize?: string | number;
  nameColor?: string;
  roleSize?: string | number;
  roleColor?: string;
}

interface Props {
  id?: string;
  data: any;
  style?: any;
}

const { id, data = {}, style = {} } = Astro.props;

const rawBgColor = data.bgColor || data.surface || style?.bgColor || style?.surface;
const resolvedBgColor = resolvePaletteColor(rawBgColor);
const isDark = ['richblack', 'deepnavy', '#111', '#111111', '#000', '#000000', '#1b1c1d'].includes(String(rawBgColor || '').toLowerCase()) || ['richblack', 'deepnavy', '#111', '#111111', '#000', '#000000', '#1b1c1d'].includes(String(resolvedBgColor || '').toLowerCase());
const textClass = isDark ? 'text-white' : 'text-paletteRichBlack';
const subTextClass = isDark ? 'text-white/80' : 'text-paletteRichBlack/80';
let inlineStyle = '';
if (resolvedBgColor) {
  inlineStyle = `background-color: ${resolvedBgColor} !important;`;
}

const pillBadge = data.pillBadge !== undefined ? data.pillBadge : '✦ BİZ KİMİZ';
const title = data.title !== undefined ? data.title : 'MÜŞTERİ DENEYİMİ VE YAPAY ZEKA EKİBİ';
const rawTag = data.headingTag || 'h1';
const HeadingTag = (['h1', 'h2', 'h3', 'h4', 'h5', 'h6'].includes(rawTag) ? rawTag : 'h1') as any;

const storyIntro = data.storyIntro !== undefined ? data.storyIntro : 'cx2222, KURUMLARIN MÜŞTERİ DENEYİMİNİ VE YAPAY ZEKA YOLCULUKLARINI İNSAN MERKEZLİ TASARIMLA DÖNÜŞTÜRMEK İÇİN BİR ARAYA GELEN ÇOK DİSİPLİNLİ BİR UZMAN KADROSUNDAN OLUŞUR.';
const storyP1 = data.storyP1 !== undefined ? data.storyP1 : 'Yapay zeka modellerinin sunduğu hız ve analitik derinlik, ancak insan sezgisi, empati ve sahada test edilmiş servis tasarımı disiplinleriyle birleştiğinde gerçek kurumsal değere dönüşür.';
const storyP2 = data.storyP2 !== undefined ? data.storyP2 : 'Veri bilimcilerimiz, deneyim tasarımcılarımız ve CX stratejistlerimizle her temas noktasında sürtünmesiz, kalıcı ve ölçülebilir deneyim ekosistemleri inşa ediyoruz.';

// Grid layout, columns & width controls (Full width by default, 5-6 columns on desktop)
const gridCols = String(data.gridCols || data.desktopCols || 'auto');
const gridColsClass = gridCols === '6'
  ? 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6'
  : gridCols === '5'
    ? 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5'
    : gridCols === '4'
      ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4'
      : 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 2xl:grid-cols-6';

const gridWidth = String(data.gridWidth || (data.photoScale === 'boxed' ? 'boxed' : 'full'));
const gridWidthClass = gridWidth === 'boxed' ? 'max-w-5xl mx-auto' : 'w-full';

const photoAspect = data.photoAspect || '4/5';
const aspectClass = photoAspect === '1/1' ? 'aspect-square' : (photoAspect === '3/4' ? 'aspect-[3/4]' : 'aspect-[4/5]');

const defaultMembers: TeamMember[] = [
  {
    id: 'ediz-pinar',
    name: 'Ediz Pınar',
    role: 'Founder & CX Principal',
    image: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=800&q=80',
    linkedin: 'https://www.linkedin.com',
  },
  {
    id: 'ai-lead',
    name: 'Can Dağdelen',
    role: 'Head of AI & Experience Engineering',
    image: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=800&q=80',
    linkedin: 'https://www.linkedin.com',
  },
  {
    id: 'design-lead',
    name: 'Aylin Yılmaz',
    role: 'Lead Service & UX Designer',
    image: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=800&q=80',
    linkedin: 'https://www.linkedin.com',
  },
  {
    id: 'quote-card',
    name: 'cx2222 Ekibi',
    role: 'Deneyim ve Sezgi Manifestosu',
    isQuoteCard: true,
    quote: 'Müşterinin sesini duymak yetmez, onu algoritmaların ve aksiyonun kalbine yerleştirmek gerekir.',
    quoteAuthor: 'cx2222 İlkesi',
    bgColor: '#BEF264',
    linkedin: 'https://www.linkedin.com',
  },
  {
    id: 'research-lead',
    name: 'Mert Aksoy',
    role: 'Senior Ethnographic Researcher',
    image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=800&q=80',
    linkedin: 'https://www.linkedin.com',
  },
  {
    id: 'analytics-lead',
    name: 'Deniz Kaya',
    role: 'VOC & Data Analytics Specialist',
    image: 'https://images.unsplash.com/photo-1522075469751-3a6694fb2f61?auto=format&fit=crop&w=800&q=80',
    linkedin: 'https://www.linkedin.com',
  },
  {
    id: 'product-lead',
    name: 'Barış Demir',
    role: 'CX Solution Architect',
    image: 'https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?auto=format&fit=crop&w=800&q=80',
    linkedin: 'https://www.linkedin.com',
  },
  {
    id: 'journey-lead',
    name: 'Selin Erdem',
    role: 'Customer Journey & Culture Lead',
    image: 'https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=800&q=80',
    linkedin: 'https://www.linkedin.com',
  },
];

const members = Array.isArray(data.members) && data.members.length > 0 ? data.members : defaultMembers;
const hasNarrative = Boolean(
  (storyIntro && storyIntro.trim() !== '') || 
  (storyP1 && storyP1.trim() !== '') || 
  (storyP2 && storyP2.trim() !== '')
);
---

<section id={id || 'ekibimiz-section'} class={`relative ${resolvedBgColor ? '' : 'bg-siteBg'} ${textClass} px-6 md:px-16 pt-[82px] md:pt-[114px] pb-20 md:pb-28`} style={inlineStyle || undefined}>
  <div class="max-w-custom mx-auto">
    
    <!-- Top Rectangular Kicker / Tag (No radius, no borders, clean site taste) -->
    {pillBadge && pillBadge.trim() !== '' && (
      <div class="mb-6">
        <span 
          class="inline-block px-3 py-1 bg-palettePlatinum text-xs font-semibold tracking-widest uppercase text-paletteRichBlack"
          style={resolveTextStyle(data, 'pillBadge')}
          set:html={formatRich(pillBadge)}
        />
      </div>
    )}

    <!-- Main Large Title -->
    {title && title.trim() !== '' && (
      <HeadingTag 
        class={`text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-light tracking-tight leading-tight ${textClass} max-w-4xl mb-12`}
        style={resolveTextStyle(data, 'title')}
      >
        <span set:html={formatRich(title)}></span>
      </HeadingTag>
    )}

    <!-- Two-Column Narrative Story (Aligned exactly with Project Detail Hero: lg:col-span-6 and lg:col-span-5 lg:col-start-8, typo-lead font-light) -->
    {hasNarrative && (
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 pt-8 pb-16 border-t border-paletteDustGrey/60 mb-16 items-start">
        {storyIntro && storyIntro.trim() !== '' && (
          <div class="lg:col-span-6">
            <p 
              class={`typo-lead font-normal leading-snug ${textClass}`}
              style={resolveTextStyle(data, 'storyIntro')}
              set:html={formatRich(storyIntro)}
            />
          </div>
        )}
        {(storyP1 || storyP2) && (
          <div class={`lg:col-span-5 lg:col-start-8 space-y-6 ${storyIntro && storyIntro.trim() !== '' ? '' : 'lg:col-span-12'}`}>
            {storyP1 && storyP1.trim() !== '' && (
              <p 
                class={`typo-lead font-light ${subTextClass} w-full max-w-none`} 
                style={resolveTextStyle(data, 'storyP1')} 
                set:html={formatRich(storyP1)}
              />
            )}
            {storyP2 && storyP2.trim() !== '' && (
              <p 
                class={`typo-lead font-light ${subTextClass} w-full max-w-none`} 
                style={resolveTextStyle(data, 'storyP2')} 
                set:html={formatRich(storyP2)}
              />
            )}
          </div>
        )}
      </div>
    )}

    <!-- Members Grid (Full Width, 5-6 Columns on Desktop) -->
    <div class={`grid ${gridColsClass} gap-5 lg:gap-6 w-full ${gridWidthClass}`}>
      {members.map((m) => {
        const activeNameSize = m.nameSize || data.nameSize;
        const activeRoleSize = m.roleSize || data.roleSize;

        const memberNameInline = [
          activeNameSize ? `font-size: ${formatSizePx(activeNameSize)} !important` : '',
          'text-transform: none !important',
          resolveTextStyle(m, 'name')
        ].filter(Boolean).join('; ');

        const memberRoleInline = [
          activeRoleSize ? `font-size: ${formatSizePx(activeRoleSize)} !important` : '',
          resolveTextStyle(m, 'role')
        ].filter(Boolean).join('; ');

        if (m.isQuoteCard) {
          const resolvedCardBg = resolvePaletteColor(m.bgColor) || m.bgColor || '#FF7452';
          const isDarkCard = ['richblack', 'deepnavy', '#111', '#111111', '#000', '#000000', '#1b1c1d'].includes(String(resolvedCardBg || '').toLowerCase());
          const cardTextColor = isDarkCard ? '#ffffff' : '#111111';
          const cardSpan = String(m.cardSpan || data.quoteCardSpan || '1');
          const spanClass = cardSpan === 'full' 
            ? 'col-span-full' 
            : cardSpan === '2' 
              ? 'col-span-1 md:col-span-2' 
              : 'col-span-1';
          return (
            <div 
              class={`p-6 sm:p-7 flex flex-col justify-between h-full min-h-[300px] transition-colors ${spanClass}`}
              style={`background-color: ${resolvedCardBg}; color: ${cardTextColor};`}
            >
              <!-- Top Author / Tag -->
              <div class="flex items-center justify-between gap-4">
                <span 
                  class={`typo-small font-bold tracking-widest ${isDarkCard ? 'text-white/70' : 'text-paletteRichBlack/70'}`}
                  style={resolveTextStyle(m, 'quoteAuthor')}
                  set:html={formatRich(m.quoteAuthor || 'cx2222 İLKESİ')}
                />
                {m.linkedin && (
                  <a 
                    href={m.linkedin} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    aria-label="LinkedIn"
                    class={`p-2 transition-opacity hover:opacity-80 ${isDarkCard ? 'text-white' : 'text-paletteRichBlack'}`}
                  >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                      <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                    </svg>
                  </a>
                )}
              </div>

              <!-- Big Bold Editorial Quote -->
              <div class="my-6">
                <p 
                  class="text-xl sm:text-2xl font-light leading-snug tracking-tight"
                  style={resolveTextStyle(m, 'quote')}
                >
                  "<span set:html={formatRich(m.quote || 'Müşterinin sesini duymak yetmez, onu algoritmaların ve aksiyonun kalbine yerleştirmek gerekir.')}></span>"
                </p>
              </div>

              <!-- Bottom Name & Role Pill -->
              <div class="pt-6 border-t border-black/10">
                <p 
                  class="font-bold text-sm tracking-wide"
                  style={memberNameInline || undefined}
                  set:html={formatRich(m.name || 'cx2222 Ekibi')}
                />
                <p 
                  class={`text-xs ${isDarkCard ? 'text-white/70' : 'text-paletteRichBlack/70'} mt-0.5`}
                  style={memberRoleInline || undefined}
                  set:html={formatRich(m.role || 'Deneyim ve Sezgi Manifestosu')}
                />
              </div>
            </div>
          );
        }

        return (
          <div class="flex flex-col group">
            <!-- Portrait Image: Sharp corners, neutral background, grayscale subtle hover effect -->
            <div class={`relative w-full ${aspectClass} bg-palettePlatinum overflow-hidden`}>
              <img 
                src={m.image} 
                alt={m.name} 
                class="w-full h-full object-cover object-center grayscale group-hover:grayscale-0 transition-all duration-500 transform group-hover:scale-105"
                loading="lazy"
              />
            </div>

            <!-- Member Meta & LinkedIn Button -->
            <div class="mt-4 flex flex-col space-y-1.5">
              <h3 
                class={`text-base font-bold tracking-wide ${textClass}`}
                style={memberNameInline || undefined}
                set:html={formatRich(m.name)}
              />
              <p 
                class={`text-xs ${subTextClass} tracking-wide`}
                style={memberRoleInline || undefined}
                set:html={formatRich(m.role)}
              />
              {m.linkedin && (
                <div class="pt-0.5">
                  <a 
                    href={m.linkedin} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class={`text-xs font-semibold ${isDark ? 'text-white/70 hover:text-white' : 'text-paletteRichBlack/70 hover:text-paletteRichBlack'} underline inline-flex items-center gap-1 transition-colors`}
                  >
                    LinkedIn ↗
                  </a>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
