---
import Heading from '../Heading.astro';
import { computeBlockStyles } from '../../lib/style';
import { resolveTextStyle, formatRich } from '../../lib/content';

interface Props {
  id?: string;
  data: any;
  style?: any;
}

const { id, data = {}, style = {} } = Astro.props;
const styles = computeBlockStyles(style);
const imagePos = data.imagePosition || 'left';
const sectionId = id || styles.sectionId || 'image-text';
const eyebrowStyle = resolveTextStyle(data, 'eyebrow');
const bodyStyle = resolveTextStyle(data, 'body');
---

<section id={sectionId} class={`py-20 md:py-32 px-6 md:px-16 ${styles.sectionClasses}`} style={styles.inlineStyleString}>
  <div class={styles.containerClass}>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      {imagePos === 'left' && data.image && (
        <div class="lg:col-span-5 aspect-[4/3] bg-neutral-200 overflow-hidden">
          <img src={data.image} alt={data.imageAlt || data.title} class="w-full h-full object-cover grayscale contrast-125" />
        </div>
      )}

      <div class={`${data.image ? 'lg:col-span-7' : 'lg:col-span-12'} space-y-6`}>
        {data.eyebrow && (
          <span class="typo-small font-bold tracking-widest text-brandAccent block" style={eyebrowStyle || undefined} set:html={formatRich(data.eyebrow)}></span>
        )}
        <Heading as={data.headingTag || data.titleTag || 'h2'} customSize={data.headingSize || data.titleSize} color={data.headingColor || data.titleColor} size="h2" text={data.title} class="text-current" />
        {data.body && (
          <p class="typo-lead font-light opacity-85 leading-relaxed" style={bodyStyle || undefined} set:html={formatRich(data.body)}>
          </p>
        )}
        {data.ctaText && (
          <div class="pt-4">
            <a href={data.ctaHref || '/iletisim'} class="btn-rect px-7 py-3 bg-paletteRichBlack text-white hover:bg-brandAccent hover:text-paletteRichBlack transition-colors" set:html={formatRich(data.ctaText)}>
            </a>
          </div>
        )}
      </div>

      {imagePos === 'right' && data.image && (
        <div class="lg:col-span-5 aspect-[4/3] bg-neutral-200 overflow-hidden">
          <img src={data.image} alt={data.imageAlt || data.title} class="w-full h-full object-cover grayscale contrast-125" />
        </div>
      )}
    </div>
  </div>
</section>
