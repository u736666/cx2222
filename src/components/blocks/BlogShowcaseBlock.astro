---
import Heading from '../Heading.astro';
import { getPostsBySlugs, getAllPosts, getBarClass, formatRich, resolveTextStyle, resolveTextTag } from '../../lib/content';
import { computeBlockStyles } from '../../lib/style';

interface Props {
  id?: string;
  data: any;
  style?: any;
}

const { id, data = {}, style = {} } = Astro.props;
const styles = computeBlockStyles(style);

const featuredSlugs = data.featuredSlugs;
const posts = (featuredSlugs && featuredSlugs.length > 0)
  ? getPostsBySlugs(featuredSlugs)
  : getAllPosts().slice(0, data.limit || 2);

const sectionId = id || styles.sectionId || 'blog-insights';
const headerTitleStyle = resolveTextStyle(data, 'heading') || resolveTextStyle(data, 'title');
---

<section id={sectionId} class={`section-pad-150 relative w-full bg-palettePlatinum text-paletteRichBlack px-6 md:px-16 overflow-hidden ${styles.sectionClasses}`} style={styles.inlineStyleString}>
  {data.bgImage && (
    <div class="absolute inset-0 w-full h-full pointer-events-none z-0">
      <img 
        src={data.bgImage} 
        alt={data.bgAlt || data.title} 
        class="w-full h-full object-cover object-center opacity-10 filter contrast-125"
      />
    </div>
  )}

  <div class={`relative z-10 ${styles.containerClass} w-full`}>
    <div class="mb-16 pb-6 flex flex-col md:flex-row md:items-end justify-between">
      <div>
        <Heading 
          as={data.headingTag || data.titleTag || 'h2'} 
          customSize={data.headingSize || data.titleSize} 
          color={data.headingColor || data.titleColor} 
          weight={data.headingWeight || data.titleWeight}
          size="h2" 
          text={data.title} 
          class="text-paletteRichBlack" 
          customStyle={headerTitleStyle}
        />
      </div>
      {data.showAllLink && data.allLinkText && (
        <a href={data.allLinkHref || '/blog'} class="btn-rect w-max font-medium text-brandAccent hover:text-paletteRichBlack transition-colors mt-4 md:mt-0" set:html={formatRich(data.allLinkText)}>
        </a>
      )}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      {posts.map((post: any) => (
        <a href={`/blog/${post.slug}`} class="flex flex-col md:flex-row items-stretch group cursor-pointer bg-siteBg transition-all overflow-hidden">
          <div class={`h-3 w-full md:h-auto md:w-5 flex-shrink-0 transition-colors ${getBarClass(post.barStyle)}`}></div>

          <div class="p-6 sm:p-8 flex-grow min-w-0 flex flex-col justify-between space-y-6">
            <div class="space-y-3">
              <Heading 
                as={post.headingTag || post.titleTag || 'h3'} 
                customSize={post.headingSize || post.titleSize} 
                color={post.headingColor || post.titleColor} 
                weight={post.headingWeight || post.titleWeight}
                size="h3" 
                text={post.title} 
                class="font-normal text-paletteRichBlack group-hover:text-brandAccent transition-colors" 
                customStyle={resolveTextStyle(post, 'title')}
              />
              <p class="typo-body font-light line-clamp-2 md:line-clamp-3 leading-relaxed text-[#111111]/75" style={resolveTextStyle(post, 'homeDesc') || resolveTextStyle(post, 'desc') || 'color: rgba(17,17,17,0.75);'} set:html={formatRich(post.homeDesc || post.desc)}>
              </p>
            </div>

            <div class="pt-4 mt-auto flex items-center justify-between">
              <span class="typo-small font-medium text-[#111111] group-hover:text-brandAccent transition-colors inline-flex items-center space-x-1.5">
                <span set:html={formatRich(data.readMoreText || 'Yazı Detayı →')}></span>
              </span>
              {post.date && (
                <span class="typo-small text-[#111111]/50 font-light" style="color: rgba(17,17,17,0.5);">{post.date}</span>
              )}
            </div>
          </div>

          <div class="w-full h-52 md:w-44 md:h-auto md:self-stretch flex-shrink-0 overflow-hidden relative p-0 m-0 bg-neutral-100">
            <img 
              src={post.image} 
              alt={post.imageAlt || post.title} 
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
            />
          </div>
        </a>
      ))}
    </div>

    {data.allLinkText && (
      <div class="mt-16 text-center">
        <a href={data.allLinkHref || '/blog'} class="btn-rect inline-flex items-center space-x-2 font-medium text-paletteRichBlack hover:text-brandAccent bg-siteBg px-8 py-3.5 transition-all">
          <span set:html={formatRich(data.allLinkText)}></span>
        </a>
      </div>
    )}
  </div>
</section>
