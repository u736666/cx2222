---
import Heading from '../Heading.astro';
import { getSurfaceStyle, resolveTextStyle, formatRich, formatSizePx } from '../../lib/content';
import { computeBlockStyles } from '../../lib/style';

interface Props {
  id?: string;
  data: any;
  style?: any;
}

const { id, data = {}, style = {} } = Astro.props;
const styles = computeBlockStyles(style);

const solutions = Array.isArray(data.items || data.solutions) ? (data.items || data.solutions) : [];
const sectionId = id || styles.sectionId || 'solutions-list';
---

<section id={sectionId} class={`pt-0 pb-20 lg:pb-[150px] bg-siteBg px-6 md:px-16 ${styles.sectionClasses}`} style={styles.inlineStyleString}>
  <div class={`${styles.containerClass} space-y-16`}>
    {solutions.map((sol: any, idx: number) => {
      const st = getSurfaceStyle(sol.style);

      const defaultBtn = sol.slug === 'ai-destekli-cx' ? 'Detaylı Çözümleri İncele →' : 'Detaylı Metodolojiyi İncele →';
      const rawBtn = sol.btnLabel !== undefined ? sol.btnLabel : defaultBtn;
      const btnText = String(rawBtn || '').trim();
      const showBtn = sol.hideBtn !== true && Boolean(btnText);
      const rawLinkText = (data.cardCtaText || btnText || 'Çözüm Detayı').trim();
      const formattedLinkText = rawLinkText.endsWith('→') ? rawLinkText : `${rawLinkText} →`;

      const bulletsFontSize = sol.bulletsSize ? formatSizePx(sol.bulletsSize) : '14px';

      return (
        <div class={`grid grid-cols-1 lg:grid-cols-12 gap-0 overflow-hidden ${st.section} relative group cursor-pointer transition-all`}>
          <!-- Full card clickable overlay link (both image and background) -->
          <a href={`/cozumler/${sol.slug}`} class="absolute inset-0 z-10" aria-label={sol.title}></a>

          <div class="lg:col-span-5 min-h-[320px] bg-neutral-200 overflow-hidden relative">
            <img 
              src={sol.image} 
              alt={sol.title} 
              class="w-full h-full object-cover grayscale contrast-125 group-hover:scale-105 transition-transform duration-700" 
            />
          </div>
          <div class="lg:col-span-7 p-8 sm:p-12 md:p-16 flex flex-col justify-between space-y-8 relative z-0">
            <div class="space-y-4">
              <Heading 
                as={sol.headingTag || 'h2'} 
                customSize={sol.headingSize || sol.titleSize} 
                color={sol.headingColor || sol.titleColor} 
                weight={sol.headingWeight || sol.titleWeight}
                size="h2" 
                text={sol.title} 
                class="text-current" 
                customStyle={resolveTextStyle(sol, 'title')}
              />
              {sol.tagline && String(sol.tagline).trim() !== '' && (
                <p class="typo-body font-normal italic opacity-80" set:html={formatRich(sol.tagline)}>
                </p>
              )}
              {sol.desc && String(sol.desc).trim() !== '' && (
                <p class="typo-body font-light opacity-80 pt-2" style={resolveTextStyle(sol, 'desc') || undefined} set:html={formatRich(sol.desc)}>
                </p>
              )}
              {Array.isArray(sol.bullets) && sol.bullets.length > 0 && (
                <div class="pt-4 space-y-2 font-light opacity-75" style={`font-size: ${bulletsFontSize} !important;`}>
                  {sol.bullets.map((b: string) => (
                    <span class="block leading-relaxed font-light" style={`font-size: ${bulletsFontSize} !important; line-height: 1.5 !important;`} set:html={`• ${formatRich(b)}`} />
                  ))}
                </div>
              )}
            </div>

            {showBtn && (
              <div class="pt-6 relative z-20 pointer-events-none">
                <span class="text-[16px] font-normal text-brandAccent group-hover:underline transition-colors inline-flex items-center gap-1.5">
                  <span set:html={formatRich(formattedLinkText)}></span>
                </span>
              </div>
            )}
          </div>
        </div>
      );
    })}
  </div>
</section>
