---
import Heading from '../Heading.astro';
import { computeBlockStyles } from '../../lib/style';

interface Props {
  id?: string;
  data: any;
  style?: any;
}

const { id, data = {}, style = {} } = Astro.props;
const styles = computeBlockStyles(style);
const items = Array.isArray(data.items || data.metrics) ? (data.items || data.metrics) : [];
const sectionId = id || styles.sectionId || 'stats';
---

<section id={sectionId} class={`py-20 md:py-28 px-6 md:px-16 ${styles.sectionClasses}`} style={styles.inlineStyleString}>
  <div class={styles.containerClass}>
    {data.title && (
      <div class="mb-12">
        <Heading as={data.headingTag || data.titleTag || 'h2'} customSize={data.headingSize || data.titleSize} color={data.headingColor || data.titleColor} size="h2" text={data.title} class="text-current" />
      </div>
    )}

    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {items.map((stat: any) => (
        <div class="space-y-2 border-l-2 border-brandAccent pl-4">
          <div class="text-4xl md:text-5xl font-extralight tracking-tight text-current">
            {stat.value}
          </div>
          <p class="typo-small font-light opacity-75">
            {stat.label}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
