---
import { computeBlockStyles } from '../../lib/style';

interface Props {
  id?: string;
  data: any;
  style?: any;
}

const { id, data = {}, style = {} } = Astro.props;
const styles = computeBlockStyles(style);

const VARSAYILAN_YUKSEKLIK = 28;
const VARSAYILAN_MAX_GENISLIK = 150;

const logoHeights: Record<string, number> = {
  'Amazon': 28,
  'Allianz': 26,
  'Vodafone': 30,
  'Mercedes': 40,
  'YILDIZ': 36,
  'LC WAIKIKI': 14,
  'MİGROS': 20,
  'IGA': 36,
  'AKBANK': 12,
  "McDonald's": 44,
  'GARANTİ': 26,
  'İŞ BANKASI': 36,
  'AKSİGORTA': 16,
  'TEB': 40,
  'TÜRK TELEKOM': 48,
  'FIAT': 36,
  'arçelik': 22,
  'Eureko': 30,
  'pluxee': 24,
  'KFC': 22,
  'MAPFRE': 18,
  'Eczacıbaşı': 26,
  'BOYNER': 14,
  'Tefal': 16,
};

const logoMaxWidths: Record<string, number> = {
  'LC WAIKIKI': 160,
  'İŞ BANKASI': 170,
};

const normName = (s: any) => String(s ?? '').toLocaleLowerCase('tr').trim();
const toNormMap = (obj: Record<string, number>) =>
  Object.fromEntries(Object.entries(obj).map(([k, v]) => [normName(k), v]));
const heightMap = toNormMap(logoHeights);
const maxWidthMap = toNormMap(logoMaxWidths);
const logoHeightOf = (name: any) => heightMap[normName(name)] ?? VARSAYILAN_YUKSEKLIK;
const logoMaxWidthOf = (name: any) => maxWidthMap[normName(name)] ?? VARSAYILAN_MAX_GENISLIK;

const rawItems = Array.isArray(data) ? data : (Array.isArray(data.items) ? data.items : []);
const items = rawItems;
const sectionId = id || styles.sectionId || 'logos';
const isMarquee = data.layout === 'marquee';
---

{isMarquee ? (
  <section id={sectionId} class={`pt-[100px] pb-10 bg-siteBg overflow-hidden ${styles.sectionClasses}`} style={styles.inlineStyleString}>
    <div class="relative w-full overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
      <div class="flex w-max items-center marquee-track hover:[animation-play-state:paused]">
        {[...items, ...items].map((logo: any) => {
          const h = logo.heightPx || logoHeightOf(logo.name);
          const maxW = logo.maxWidthPx || logoMaxWidthOf(logo.name);
          const isGrayscale = (data.grayscale && !logo.originalColors) || logo.grayscale;
          const imgFilterClass = isGrayscale ? 'filter grayscale contrast-125' : '';
          return (
            <div class="flex items-center justify-center flex-shrink-0 px-8 opacity-85 hover:opacity-100 transition-opacity">
              <img 
                src={logo.image || logo.src} 
                alt={logo.name} 
                class={`w-auto object-contain ${imgFilterClass}`}
                style={`height: ${h}px; max-width: ${maxW}px;`}
              />
            </div>
          );
        })}
      </div>
    </div>
  </section>
) : (
  <section id={sectionId} class={`section-pad-150 px-6 md:px-16 bg-siteBg ${styles.sectionClasses}`} style={styles.inlineStyleString}>
    <div class="max-w-custom mx-auto">
      <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-x-8 gap-y-12 sm:gap-y-16 lg:gap-y-[110px] items-center justify-items-center opacity-75">
        {items.map((logo: any) => (
          logo.kind === 'svg' ? (
            <svg class={logo.class} viewBox={logo.viewBox} set:html={logo.body} aria-label={logo.name} />
          ) : logo.kind === 'image' ? (
            <img
              src={logo.image || logo.src}
              alt={logo.name}
              style={`height:${logo.heightPx || logoHeightOf(logo.name)}px; max-width:${logo.maxWidthPx || logoMaxWidthOf(logo.name)}px;`}
              class={`w-auto object-contain opacity-85 hover:opacity-100 transition-opacity ${data.grayscale ? 'grayscale' : ''}`}
            />
          ) : (
            <svg class={`${logo.height || 'h-5'} w-auto fill-paletteRichBlack hover:fill-brandAccent transition-colors`} viewBox={logo.viewBox || '0 0 120 24'}>
              <text
                x="0"
                y={logo.y || '18'}
                font-family="'Sora', sans-serif"
                font-weight={logo.fontWeight || '700'}
                font-size={logo.fontSize || '18'}
                fill="currentColor"
                letter-spacing={logo.letterSpacing || '1'}
              >
                {logo.text || logo.name}
              </text>
            </svg>
          )
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .marquee-track {
    animation: marquee 35s linear infinite;
  }
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
