---
import Heading from '../Heading.astro';
import { getAllProjects, getSurfaceStyle, resolveTextStyle, resolveTextTag, formatRich } from '../../lib/content';
import { computeBlockStyles } from '../../lib/style';

interface Props {
  id?: string;
  data: any;
  style?: any;
}

const { id, data = {}, style = {} } = Astro.props;
const styles = computeBlockStyles(style);
const projects = getAllProjects();
const sectionId = id || styles.sectionId || 'projects-list';
---

<section id={sectionId} class={`section-pad-150 bg-siteBg px-6 md:px-16 ${styles.sectionClasses}`} style={styles.inlineStyleString}>
  <div class={`${styles.containerClass} space-y-16`}>
    {projects.map((proj: any) => {
      const st = getSurfaceStyle(proj.listStyle);
      const accentClass = proj.listStyle === 'platinum' || proj.listStyle === 'richBlack' ? 'text-brandAccent' : 'text-paletteRichBlack';
      return (
        <div class={`overflow-hidden ${st.section} relative group cursor-pointer transition-all`}>
          <!-- Full card clickable overlay link (both image and background) -->
          <a href={`/projeler/${proj.slug}`} class="absolute inset-0 z-10" aria-label={`${proj.client} - ${proj.title}`}></a>

          <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch min-h-[480px] relative z-0">
            <div class="lg:col-span-6 relative min-h-[320px] lg:min-h-full overflow-hidden bg-neutral-200">
              <img 
                src={proj.image} 
                alt={proj.imageAlt || proj.shortTitle || proj.title} 
                class="w-full h-full object-cover grayscale contrast-125 group-hover:scale-105 transition-transform duration-700"
              />
            </div>

            <div class="lg:col-span-6 p-8 sm:p-12 md:p-14 flex flex-col justify-between space-y-8">
              <div class="space-y-4">
                <span class={`typo-body tracking-widest font-semibold block ${accentClass}`} style={resolveTextStyle(proj, 'client') || undefined} set:html={formatRich(proj.client)}>
                </span>
                <Heading as={proj.headingTag || proj.titleTag || 'h2'} customSize={proj.headingSize || proj.titleSize} color={proj.headingColor || proj.titleColor} size="h2" text={proj.shortTitle || proj.title} class="text-current" />
                <p class="typo-body font-light opacity-80 pt-2" style={resolveTextStyle(proj, 'listDesc') || resolveTextStyle(proj, 'desc') || undefined} set:html={formatRich(proj.listDesc || proj.desc)}>
                </p>
                {Array.isArray(proj.bullets) && proj.bullets.length > 0 && (() => {
                  const BulletTag = (resolveTextTag(proj, 'bullets', 'p') || 'p') as any;
                  const bulletStyle = resolveTextStyle(proj, 'bullets') || undefined;
                  return (
                    <div class="pt-4 space-y-2 typo-body font-light opacity-75">
                      {proj.bullets.map((b: string) => (
                        <BulletTag style={bulletStyle} set:html={`• ${formatRich(b)}`} />
                      ))}
                    </div>
                  );
                })()}
              </div>

              <div class="pt-6 relative z-20 pointer-events-none">
                <span class={`btn-rect font-medium ${accentClass} group-hover:underline transition-colors`}>
                  <span set:html={formatRich(data.cardCtaText || 'Vaka Detaylarını İncele →')}></span>
                </span>
              </div>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>
