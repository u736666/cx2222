---
import Heading from '../Heading.astro';
import { computeBlockStyles } from '../../lib/style';

interface Props {
  id?: string;
  data: any;
  style?: any;
}

const { id, data = {}, style = {} } = Astro.props;
const styles = computeBlockStyles(style);
const sectionId = id || styles.sectionId || 'rich-text';
---

<section id={sectionId} class={`py-16 md:py-24 px-6 md:px-16 ${styles.sectionClasses}`} style={styles.inlineStyleString}>
  <div class={styles.containerClass}>
    <div class="space-y-6 max-w-4xl mx-auto">
      {data.title && (
        <Heading as={data.headingTag || data.titleTag || 'h2'} customSize={data.headingSize || data.titleSize} color={data.headingColor || data.titleColor} size="h2" text={data.title} class="text-current" />
      )}
      {data.content && (
        <div class="prose prose-lg max-w-none text-current font-light leading-relaxed" set:html={data.content} />
      )}
    </div>
  </div>
</section>
