---
import Heading from '../Heading.astro';
import { computeBlockStyles } from '../../lib/style';
import { resolveTextStyle } from '../../lib/content';

interface Props {
  id?: string;
  data: any;
  style?: any;
}

const { id, data = {}, style = {} } = Astro.props;
const styles = computeBlockStyles(style);
const sectionId = id || styles.sectionId || 'rich-text';

const subheadingWeight = data.subheadingWeight || '400';
const subheadingSize = data.subheadingSize || '1.25rem';
---

<section id={sectionId} class={`py-16 md:py-24 px-6 md:px-16 ${styles.sectionClasses}`} style={styles.inlineStyleString}>
  <div class={styles.containerClass}>
    <div class="space-y-6 max-w-4xl mx-auto">
      {data.title && String(data.title).trim() !== '' && (
        <Heading 
          as={data.headingTag || data.titleTag || 'h2'} 
          customSize={data.headingSize || data.titleSize} 
          color={data.headingColor || data.titleColor} 
          weight={data.headingWeight || data.titleWeight}
          size="h2" 
          text={data.title} 
          class="text-current" 
          customStyle={resolveTextStyle(data, 'title')}
        />
      )}
      {data.content && (
        <div class="rich-text-body prose prose-lg max-w-none text-current font-light leading-relaxed" set:html={data.content} />
      )}
    </div>
  </div>
</section>

<style is:global define:vars={{ subheadingWeight, subheadingSize }}>
  .rich-text-body h1,
  .rich-text-body h2,
  .rich-text-body h3,
  .rich-text-body h4,
  .rich-text-body h5,
  .rich-text-body h6 {
    font-weight: var(--subheadingWeight, 400) !important;
    font-size: var(--subheadingSize, 1.25rem);
    letter-spacing: -0.01em;
    margin-top: 2rem !important;
    margin-bottom: 0.75rem !important;
  }
</style>
