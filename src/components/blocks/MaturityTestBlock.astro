---
import Heading from '../Heading.astro';
import { computeBlockStyles } from '../../lib/style';

interface Props {
  id?: string;
  data: any;
  style?: any;
}

const { id, data = {}, style = {} } = Astro.props;
const styles = computeBlockStyles(style);

const questions = Array.isArray(data.questions) ? data.questions : [];
const results = Array.isArray(data.results) ? data.results : [];
const sectionId = id || styles.sectionId || 'maturity-test';
---

<section id={sectionId} class={`section-pad-150 bg-siteBg text-paletteRichBlack px-6 md:px-16 ${styles.sectionClasses}`} style={styles.inlineStyleString}>
  <div class="max-w-4xl mx-auto">
    
    <!-- Progress Bar -->
    <div class="mb-8">
      <div class="flex items-center justify-between typo-small font-semibold tracking-widest text-paletteRichBlack/60 mb-3">
        <span id="step-counter">Soru 1 / {questions.length}</span>
        <span id="step-percent">%{Math.round(100 / Math.max(questions.length, 1))}</span>
      </div>
      <div class="w-full h-1.5 bg-palettePlatinum overflow-hidden">
        <div id="progress-fill" class="h-full bg-brandAccent transition-all duration-300 w-1/5"></div>
      </div>
    </div>

    <!-- Sharp Rectangular Quiz Card -->
    <div id="quiz-container" class="bg-palettePlatinum p-8 md:p-14 min-h-[420px] flex flex-col justify-between">
      
      <div id="question-block">
        <span id="question-category" class="typo-small font-semibold tracking-widest text-paletteRichBlack/60 block mb-3" set:html={questions[0]?.category}>
        </span>
        <Heading as="h2" size="h2" id="question-title" text={questions[0]?.title} class="text-paletteRichBlack mb-8" />

        <div id="options-list" class="space-y-[2px]">
          <!-- Options injected dynamically by JS -->
        </div>
      </div>

      <!-- Lead Capture Block (Shown after questions finish, before revealing results) -->
      <div id="lead-capture-block" class="hidden space-y-6">
        <div>
          <span class="typo-small font-semibold tracking-widest text-brandAccent bg-paletteRichBlack px-4 py-1.5 inline-block mb-3">
            Teşhis Tamamlandı
          </span>
          <h3 class="text-2xl sm:text-3xl font-light text-paletteRichBlack tracking-tight leading-snug">
            Kurumsal Olgunluk Raporunuz Hazır
          </h3>
          <p class="typo-body text-paletteRichBlack/80 font-light mt-2 max-w-xl">
            Kurumunuza özel CX & AI olgunluk skorunuzu ve öncelikli aksiyon planınızı görüntülemek ve detaylı raporu almak için lütfen e-posta adresinizi girin.
          </p>
        </div>

        <form id="lead-capture-form" class="space-y-4 max-w-lg pt-2">
          <div>
            <label for="lead-email" class="block text-xs font-semibold uppercase tracking-wider text-paletteRichBlack/70 mb-1.5">
              İş E-posta Adresi <span class="text-red-500">*</span>
            </label>
            <input 
              type="email" 
              id="lead-email" 
              required 
              placeholder="ad.soyad@sirketiniz.com"
              class="w-full px-4 py-3 bg-white border border-palettePlatinum focus:border-paletteRichBlack outline-none text-paletteRichBlack text-sm transition-colors"
            />
          </div>

          <div>
            <label for="lead-name" class="block text-xs font-semibold uppercase tracking-wider text-paletteRichBlack/70 mb-1.5">
              Ad Soyad (Opsiyonel)
            </label>
            <input 
              type="text" 
              id="lead-name" 
              placeholder="Adınız Soyadınız"
              class="w-full px-4 py-3 bg-white border border-palettePlatinum focus:border-paletteRichBlack outline-none text-paletteRichBlack text-sm transition-colors"
            />
          </div>

          <div class="pt-2">
            <button 
              type="submit" 
              class="group min-h-[2.25rem] py-2 px-6 rounded-full bg-brandAccent hover:bg-brandAccentHover text-paletteRichBlack font-medium text-[14px] inline-flex items-center gap-1.5 transition-all cursor-pointer border-0 shadow-none"
              style="border: none !important; outline: none !important;"
            >
              <span>Sonuçları Gör ve Raporu İlet</span>
              <span class="inline-block transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
            </button>
          </div>
          <p class="text-xs text-paletteRichBlack/60 font-light">
            Bilgileriniz üçüncü taraflarla paylaşılmaz. Sadece analiz çıktısı ve ilgili deneyim içgörüleri için kullanılır.
          </p>
        </form>
      </div>

      <!-- Result Block -->
      <div id="result-block" class="hidden space-y-6">
        <div class="flex flex-wrap items-center gap-3">
          <span class="typo-small font-semibold tracking-widest text-brandAccent bg-paletteRichBlack px-4 py-1.5 inline-block">
            Teşhis Sonucunuz
          </span>
          <span id="lead-sent-tag" class="text-xs font-medium text-emerald-800 bg-emerald-100 px-3 py-1 hidden">
            ✓ Rapor e-posta adresinize kaydedildi
          </span>
        </div>
        <Heading as="h3" size="h2" id="result-level-title" class="text-paletteRichBlack" />
        <p id="result-desc" class="typo-body text-paletteRichBlack/80 font-light"></p>

        <div class="p-8 bg-siteBg">
          <Heading as="h4" size="h4" class="font-bold tracking-widest text-brandAccent mb-4">İlk 3 Aksiyon Önerisi</Heading>
          <ul id="result-recommendations" class="space-y-3 typo-body font-light text-paletteRichBlack/80">
          </ul>
        </div>

        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a 
            href="/iletisim"
            class="group min-h-[2.25rem] py-2 px-6 rounded-full bg-brandAccent hover:bg-brandAccentHover text-paletteRichBlack font-medium text-[14px] inline-flex items-center gap-1.5 transition-all cursor-pointer border-0 shadow-none"
            style="border: none !important; outline: none !important;"
          >
            <span>Sonuçları Birlikte Değerlendirelim</span>
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
          <button 
            id="restart-quiz-btn"
            type="button"
            class="min-h-[2.25rem] py-2 px-5 rounded-full border border-paletteRichBlack text-paletteRichBlack hover:bg-paletteRichBlack hover:text-white font-medium text-[14px] inline-flex items-center gap-1.5 transition-all cursor-pointer"
          >
            Testi Yeniden Başlat
          </button>
        </div>
      </div>

    </div>

  </div>
</section>

<script define:vars={{ questions, results }}>
  let currentQ = 0;
  let totalScore = 0;

  const stepCounter = document.getElementById('step-counter');
  const stepPercent = document.getElementById('step-percent');
  const progressFill = document.getElementById('progress-fill');
  const questionBlock = document.getElementById('question-block');
  const leadCaptureBlock = document.getElementById('lead-capture-block');
  const leadCaptureForm = document.getElementById('lead-capture-form');
  const leadEmailInput = document.getElementById('lead-email');
  const leadSentTag = document.getElementById('lead-sent-tag');
  const resultBlock = document.getElementById('result-block');
  const questionCat = document.getElementById('question-category');
  const questionTitle = document.getElementById('question-title');
  const optionsList = document.getElementById('options-list');
  const restartBtn = document.getElementById('restart-quiz-btn');

  function renderQuestion(idx) {
    const q = questions[idx];
    if (!q) return;

    if (stepCounter) stepCounter.textContent = `Soru ${idx + 1} / ${questions.length}`;
    const pct = Math.round(((idx + 1) / questions.length) * 100);
    if (stepPercent) stepPercent.textContent = `%${pct}`;
    if (progressFill) progressFill.style.width = `${pct}%`;

    if (questionCat) questionCat.textContent = q.category;
    if (questionTitle) questionTitle.textContent = q.title;

    if (optionsList) {
      optionsList.innerHTML = '';
      q.options.forEach((opt) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'w-full text-left p-5 bg-siteBg hover:bg-paletteRichBlack hover:text-white transition-all duration-200 flex items-center justify-between group cursor-pointer';
        btn.innerHTML = `
          <span class="min-w-0 text-sm md:text-base font-light">${opt.text}</span>
          <span class="ml-4 flex-shrink-0 text-sm font-semibold text-brandAccent">→</span>
        `;
        btn.addEventListener('click', () => {
          totalScore += opt.points;
          if (currentQ < questions.length - 1) {
            currentQ++;
            renderQuestion(currentQ);
          } else {
            showLeadCapture();
          }
        });
        optionsList.appendChild(btn);
      });
    }
  }

  function showLeadCapture() {
    if (questionBlock) questionBlock.classList.add('hidden');
    if (resultBlock) resultBlock.classList.add('hidden');
    if (leadCaptureBlock) leadCaptureBlock.classList.remove('hidden');
    if (stepCounter) stepCounter.textContent = 'Son Aşama';
    if (stepPercent) stepPercent.textContent = '%100';
    if (progressFill) progressFill.style.width = '100%';
  }

  if (leadCaptureForm) {
    leadCaptureForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = leadEmailInput ? leadEmailInput.value.trim() : '';
      if (!email) return;

      try {
        const savedLeads = JSON.parse(localStorage.getItem('cx_maturity_leads') || '[]');
        savedLeads.push({ email, score: totalScore, date: new Date().toISOString() });
        localStorage.setItem('cx_maturity_leads', JSON.stringify(savedLeads));
      } catch (err) {
        // ignore local storage error
      }

      if (leadSentTag) {
        leadSentTag.textContent = `✓ Rapor ${email} adresine kaydedildi`;
        leadSentTag.classList.remove('hidden');
      }

      if (leadCaptureBlock) leadCaptureBlock.classList.add('hidden');
      showResult();
    });
  }

  function showResult() {
    if (questionBlock) questionBlock.classList.add('hidden');
    if (leadCaptureBlock) leadCaptureBlock.classList.add('hidden');
    if (resultBlock) resultBlock.classList.remove('hidden');

    const resultTitle = document.getElementById('result-level-title');
    const resultDesc = document.getElementById('result-desc');
    const resultRecs = document.getElementById('result-recommendations');

    const sorted = [...results].sort((a, b) => a.maxScore - b.maxScore);
    const tier = sorted.find((r) => totalScore <= r.maxScore) || sorted[sorted.length - 1];

    if (resultTitle && tier) resultTitle.textContent = tier.title;
    if (resultDesc && tier) resultDesc.textContent = tier.desc;
    if (resultRecs && tier) {
      resultRecs.innerHTML = (tier.recommendations || []).map(r => `<li>${r}</li>`).join('');
    }
  }

  function restart() {
    currentQ = 0;
    totalScore = 0;
    if (resultBlock) resultBlock.classList.add('hidden');
    if (leadCaptureBlock) leadCaptureBlock.classList.add('hidden');
    if (questionBlock) questionBlock.classList.remove('hidden');
    if (leadSentTag) leadSentTag.classList.add('hidden');
    renderQuestion(0);
  }

  if (restartBtn) restartBtn.addEventListener('click', restart);

  document.addEventListener('DOMContentLoaded', () => {
    renderQuestion(0);
  });
</script>
