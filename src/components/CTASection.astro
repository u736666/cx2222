---
import { getSite, resolveTextStyle, formatRich } from '../lib/content';

interface Props {
  title?: string;
  desc?: string;
  eyebrow?: string;
  headingTag?: string;
  headingSize?: string;
  headingColor?: string;
  descSize?: string;
  descColor?: string;
  eyebrowColor?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  surface?: string;
  bgColor?: string;
  bgImage?: string;
  bgAlt?: string;
  visible?: boolean;
  showCta?: boolean;
  selectedCtaId?: string;
  fullWidth?: boolean;
  precedingBg?: string;
  followedByFooter?: boolean;
  followedByForm?: boolean;
}

const site = getSite() as any;
const cta = site.cta || {};
const library: any[] = site.ctaLibrary || [];

// 1. Resolve card from library
const targetId = Astro.props.selectedCtaId || 'default-consulting';
const card = library.find((c: any) => c.id === targetId) || library[0] || {};

// Helper to resolve value: explicit prop > card from library > site.cta fallback
function resolveVal(propVal: any, cardVal: any, fallbackVal: any = '') {
  if (propVal !== undefined && propVal !== null && String(propVal).trim() !== '') {
    return String(propVal).trim();
  }
  if (cardVal !== undefined && cardVal !== null) {
    return String(cardVal).trim();
  }
  if (fallbackVal !== undefined && fallbackVal !== null) {
    return String(fallbackVal).trim();
  }
  return '';
}

// 2. Resolve content (explicit prop > card from library > site.cta)
const title = resolveVal(Astro.props.title, card.title, cta.title);
const desc = resolveVal(Astro.props.desc, card.desc, cta.desc);
const eyebrow = resolveVal(Astro.props.eyebrow, card.eyebrow, cta.eyebrow);

const rawPrimaryLabel = resolveVal(Astro.props.primaryLabel, card.primaryLabel, cta.primaryLabel);
const primaryHref = resolveVal(Astro.props.primaryHref, card.primaryHref, cta.primaryHref || '#');
const rawSecondaryLabel = resolveVal(Astro.props.secondaryLabel, card.secondaryLabel, cta.secondaryLabel);
const secondaryHref = resolveVal(Astro.props.secondaryHref, card.secondaryHref, cta.secondaryHref || '#');

// Strip trailing arrow if present so we can add animated arrow
const primaryLabel = rawPrimaryLabel.replace(/\s*[→↗]\s*$/, '');
const secondaryLabel = rawSecondaryLabel.replace(/\s*[→↗]\s*$/, '');

const hasEyebrow = Boolean(eyebrow && eyebrow.trim());
const hasTitle = Boolean(title && title.trim());
const hasDesc = Boolean(desc && desc.trim());
const hasPrimary = Boolean(primaryLabel && primaryLabel.trim());
const hasSecondary = Boolean(secondaryLabel && secondaryLabel.trim());
const hasButtons = hasPrimary || hasSecondary;

// Surface: default to 'mesh' (TheDive animated noise gradient)
const surface = Astro.props.surface || card.surface || 'mesh';
const bgColor = Astro.props.bgColor || card.bgColor || '';
const bgImage = Astro.props.bgImage || card.bgImage || '';
const bgAlt = Astro.props.bgAlt || card.bgAlt || title || '';

const rawTag = Astro.props.headingTag || card.headingTag || cta?.headingTag;
const HeadingTag = (['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'p', 'div'].includes(rawTag || '') ? rawTag : 'h2') as any;

const isVisible = Astro.props.visible !== false && Astro.props.showCta !== false && cta?.showCta !== false;

const baseTitleStyle = resolveTextStyle(Astro.props, 'title') || resolveTextStyle(Astro.props, 'heading') || resolveTextStyle(card, 'title') || resolveTextStyle(cta, 'title') || '';
const baseDescStyle = resolveTextStyle(Astro.props, 'desc') || resolveTextStyle(card, 'desc') || resolveTextStyle(cta, 'desc') || '';
const baseEyebrowStyle = resolveTextStyle(Astro.props, 'eyebrow') || resolveTextStyle(card, 'eyebrow') || resolveTextStyle(cta, 'eyebrow') || '';

let customTitleStyle = baseTitleStyle;
const headingSize = Astro.props.headingSize || card.headingSize;
if (headingSize && !customTitleStyle.includes('font-size')) {
  customTitleStyle += `font-size: ${headingSize}${typeof headingSize === 'number' || /^\d+$/.test(headingSize) ? 'px' : ''};`;
}
const headingColor = Astro.props.headingColor || card.headingColor;
if (headingColor && !customTitleStyle.includes('color')) {
  customTitleStyle += `color: ${headingColor};`;
}

let customDescStyle = baseDescStyle;
const descSize = Astro.props.descSize || card.descSize;
if (descSize && !customDescStyle.includes('font-size')) {
  customDescStyle += `font-size: ${descSize}${typeof descSize === 'number' || /^\d+$/.test(descSize) ? 'px' : ''};`;
}
const descColor = Astro.props.descColor || card.descColor;
if (descColor && !customDescStyle.includes('color')) {
  customDescStyle += `color: ${descColor};`;
}

let customEyebrowStyle = baseEyebrowStyle;
const eyebrowColor = Astro.props.eyebrowColor || card.eyebrowColor;
if (eyebrowColor && !customEyebrowStyle.includes('color')) {
  customEyebrowStyle += `color: ${eyebrowColor};`;
}

const surfaceMap: Record<string, { card: string; eyebrow: string; title: string; desc: string }> = {
  mesh: {
    card: 'cta-mesh-gradient text-paletteRichBlack',
    eyebrow: 'text-paletteRichBlack/60 font-semibold tracking-wider',
    title: 'text-paletteRichBlack',
    desc: 'text-paletteRichBlack/80',
  },
  platinum: {
    card: 'bg-palettePlatinum',
    eyebrow: 'text-paletteRichBlack/60',
    title: 'text-paletteRichBlack',
    desc: 'text-paletteRichBlack/75',
  },
  dustGrey: {
    card: 'bg-paletteDustGrey',
    eyebrow: 'text-paletteRichBlack/60',
    title: 'text-paletteRichBlack',
    desc: 'text-paletteRichBlack/75',
  },
  siteBg: {
    card: 'bg-siteBg',
    eyebrow: 'text-brandAccent',
    title: 'text-paletteRichBlack',
    desc: 'text-paletteRichBlack/75',
  },
  brandAccent: {
    card: 'bg-brandAccent',
    eyebrow: 'text-paletteRichBlack/80',
    title: 'text-paletteRichBlack',
    desc: 'text-paletteRichBlack/85',
  },
  richBlack: {
    card: 'bg-paletteRichBlack text-white',
    eyebrow: 'text-brandAccent',
    title: 'text-white',
    desc: 'text-white/80',
  },
};

const sf = surfaceMap[surface] || surfaceMap.mesh || surfaceMap.platinum;
const isDark = surface === 'richBlack' || (bgColor && (bgColor === '#1B1C1D' || bgColor.toLowerCase() === '#111' || bgColor.toLowerCase() === '#000'));

let cardStyle = '';
if (bgColor) {
  cardStyle += `background-color: ${bgColor};`;
}

// Padding kuralları (Dive stili):
// 1. Öncesindeki section beyaz (#ffffff / siteBg) ise padding-top: 0
const isPrecedingWhite = Astro.props.precedingBg === '#ffffff' || Astro.props.precedingBg === 'white' || Astro.props.precedingBg === 'siteBg' || Astro.props.precedingBg === undefined;
// 2. CTA sonrası footer veya form geliyorsa bottom padding: 0
const isFollowedByFooterOrForm = Astro.props.followedByFooter !== false || Astro.props.followedByForm === true;

const sectionPadClass = `${isPrecedingWhite ? 'pt-0' : 'pt-12 md:pt-16'} ${isFollowedByFooterOrForm ? 'pb-0' : 'pb-16 md:pb-24'}`;
---

{isVisible && (
<section class={`w-full relative ${sectionPadClass} overflow-hidden bg-siteBg`}>
  <div class={`w-full ${sf.card} py-16 md:py-24 px-6 md:px-16 relative overflow-hidden`} style={cardStyle || undefined}>
    {bgImage && (
      <div class="absolute inset-0 w-full h-full pointer-events-none z-0">
        <img 
          src={bgImage} 
          alt={bgAlt || title || ''} 
          class="w-full h-full object-cover object-center opacity-30 filter contrast-125"
        />
        <div class={`absolute inset-0 ${isDark ? 'bg-black/40' : 'bg-white/20'}`}></div>
      </div>
    )}
    <div class="max-w-custom mx-auto relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class={`${hasButtons ? 'lg:col-span-8' : 'lg:col-span-12'} space-y-5`}>
        {hasEyebrow && (
          <span class={`typo-small font-semibold tracking-widest block ${sf.eyebrow}`} style={customEyebrowStyle || undefined} set:html={formatRich(eyebrow)}></span>
        )}
        {hasTitle && (
          <HeadingTag class={`typo-h2 ${sf.title}`} style={customTitleStyle || undefined} set:html={formatRich(title)}>
          </HeadingTag>
        )}
        {hasDesc && (
          <p class={`typo-lead font-light ${hasButtons ? 'max-w-2xl' : 'max-w-4xl'} ${sf.desc}`} style={customDescStyle || undefined} set:html={formatRich(desc)}>
          </p>
        )}
      </div>

      {hasButtons && (
        <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-4 lg:items-end justify-center">
          {hasPrimary && (
            <a 
              href={primaryHref}
              class={`pill-outline-btn group inline-flex items-center gap-2 px-6 py-2 rounded-full border text-sm font-medium transition-all duration-300 w-full sm:w-auto lg:w-max min-h-[2.25rem] ${isDark ? 'border-white text-white hover:bg-white hover:text-paletteRichBlack' : 'border-paletteRichBlack text-paletteRichBlack hover:bg-paletteRichBlack hover:text-white'}`}
            >
              <span>{primaryLabel}</span>
              <span class="inline-block transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          )}
          {hasSecondary && (
            <a 
              href={secondaryHref}
              class={`pill-outline-btn group inline-flex items-center gap-2 px-6 py-2 rounded-full border text-sm font-medium transition-all duration-300 w-full sm:w-auto lg:w-max min-h-[2.25rem] ${isDark ? 'border-white/60 text-white/90 hover:bg-white hover:text-paletteRichBlack' : 'border-paletteRichBlack/60 text-paletteRichBlack/90 hover:bg-paletteRichBlack hover:text-white'}`}
            >
              <span>{secondaryLabel}</span>
              <span class="inline-block transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</section>
)}
