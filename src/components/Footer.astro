---
import { getSite } from '../lib/content';

const year = new Date().getFullYear();
const site = getSite();
const footer = site.footer || ({} as any);
const showFooter = footer.showFooter !== false;
const showCopyright = footer.showCopyright !== false;
const showYear = footer.showYear !== false;
const links = Array.isArray(footer.links) ? footer.links : [];
const socialLinks = Array.isArray(footer.socialLinks) && footer.socialLinks.length > 0
  ? footer.socialLinks
  : (site.brand?.social || []);
---

{showFooter && (
<footer class="w-full bg-paletteRichBlack text-white px-6 md:px-16 pt-16 md:pt-20 pb-12 border-t border-white/10" style="background-color: var(--color-rich-black);">
  <div class="max-w-custom mx-auto w-full space-y-12">
    
    <!-- Üst Sütunlar: Marka + Navigasyon (TheDive Stili) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 pb-12 border-b border-white/10">
      
      <!-- Marka Logosu (Header Logosu ile Aynı Boyut ve Tasarım) -->
      <div class="lg:col-span-4 space-y-6">
        <a href="/" class="inline-flex items-center hover:opacity-85 transition-opacity text-white text-2xl leading-none tracking-normal">
          {site.brand?.logoImage ? (
            <img src={site.brand.logoImage} alt={site.brand?.name || 'cxfolks'} class="h-7 w-auto object-contain brightness-0 invert" />
          ) : (
            <><span class="font-light text-white">{site.brand?.prefix || 'cx'}</span><span class="font-bold text-white">{site.brand?.suffix || 'folks'}</span></>
          )}
        </a>
        <p class="typo-body font-light text-white/70 max-w-sm">
          {site.brand?.slogan || 'Yapay zeka çağında insan odaklı müşteri deneyimi ve servis tasarımı danışmanlığı.'}
        </p>

        <div class="space-y-2 typo-small font-light text-white/60">
          {(site.brand?.offices || []).map((o: any) => (
            <div>{o.city} • {o.district}</div>
          ))}
        </div>
      </div>

      <!-- Çözümler Sütunu (Capitalize) -->
      <div class="lg:col-span-3 space-y-4">
        <span class="text-[15px] font-semibold tracking-normal text-white block">Çözümler</span>
        <ul class="space-y-2.5 typo-small font-light text-white/70">
          <li><a href="/cozumler/ai-destekli-cx" class="hover:text-brandAccent transition-colors">AI Destekli CX</a></li>
          <li><a href="/cozumler/deneyim-tasarimi" class="hover:text-brandAccent transition-colors">Deneyim Tasarımı</a></li>
          <li><a href="/cozumler/akademi" class="hover:text-brandAccent transition-colors">CX Folks Akademi</a></li>
          <li><a href="/cozumler/cx-maturity-testi" class="hover:text-brandAccent transition-colors">Maturity Testi</a></li>
        </ul>
      </div>

      <!-- Kurumsal Sütunu (Tepe Menüyle Aynı İsimler, Neden Şimdi Kaldırıldı) -->
      <div class="lg:col-span-3 space-y-4">
        <span class="text-[15px] font-semibold tracking-normal text-white block">Kurumsal</span>
        <ul class="space-y-2.5 typo-small font-light text-white/70">
          <li><a href="/yaklasimimiz" class="hover:text-brandAccent transition-colors">Yaklaşımımız</a></li>
          <li><a href="/ekibimiz" class="hover:text-brandAccent transition-colors">Ekibimiz</a></li>
          <li><a href="/projeler" class="hover:text-brandAccent transition-colors">Projeler</a></li>
          <li><a href="/blog" class="hover:text-brandAccent transition-colors">Blog</a></li>
        </ul>
      </div>

      <!-- Sosyal & İletişim Bağlantıları -->
      <div class="lg:col-span-2 space-y-4">
        <span class="text-[15px] font-semibold tracking-normal text-white block">Bağlantıda Kalın</span>
        <div class="flex flex-col space-y-2.5 typo-small font-light text-white/70">
          {socialLinks.map((s: any) => (
            <a
              href={s.url || s.href || '#'}
              target={(s.url || s.href || '').startsWith('http') ? '_blank' : undefined}
              rel={(s.url || s.href || '').startsWith('http') ? 'noopener noreferrer' : undefined}
              class="hover:text-brandAccent transition-colors inline-flex items-center gap-1.5"
            >
              <span>{(s.name || s.label || '').replace(/\s*[→↗]\s*$/, '')}</span>
              <span class="text-xs opacity-60">↗</span>
            </a>
          ))}
          <a href="/iletisim" class="hover:text-brandAccent transition-colors inline-flex items-center gap-1.5 pt-1 text-white/80">
            <span>İletişim</span>
            <span class="text-xs">→</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Alt Satır: Telif Hakkı (14px) & Hukuki / Gizlilik / Çerez Bağlantıları -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 text-[14px] font-light text-white/60 pt-2">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        {showCopyright && (
          <p class="text-[14px]">
            {footer.copyrightPrefix || '© '}
            {showYear ? `${year} ` : ''}
            {footer.copyrightSuffix || 'CX Folks. Tüm hakları saklıdır.'}
          </p>
        )}
        {footer.extraNote && (
          <span class="text-white/40 text-[14px]">{footer.extraNote}</span>
        )}
      </div>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-[14px] text-white/60">
        <a href="/gizlilik-politikasi" class="hover:text-white transition-colors">Gizlilik Politikası & KVKK</a>
        <a href="/cerez-politikasi" class="hover:text-white transition-colors">Çerez Politikası</a>
        <a href="/iletisim" class="hover:text-white transition-colors">İletişim</a>
      </div>
    </div>

  </div>
</footer>
)}
