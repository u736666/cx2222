---
import Layout from '../../layouts/Layout.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTASection from '../../components/CTASection.astro';
import { getPages, getSite, getSurfaceStyle } from '../../lib/content';

const { aiDestekliCx: data } = getPages();
const site = getSite();
const HeroTag = (['h1', 'h2', 'h3', 'h4'].includes(data.hero?.headingTag || '') ? data.hero.headingTag : 'h1') as 'h1' | 'h2' | 'h3' | 'h4';

const [eyebrowTop, eyebrowBottom] = data.hero.eyebrow.split('*').map((s) => s.trim());

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": data.seo?.schemaType || "Service",
  "name": data.seo?.headline || "AI Destekli Müşteri Deneyimi (CX) & VOC Kurulumu",
  "provider": {
    "@type": "Organization",
    "name": site.brand.name,
    "url": site.brand.siteUrl
  },
  "serviceType": "Müşteri Deneyimi Danışmanlığı & AI Entegrasyonu",
  "description": data.seo?.schemaDesc || data.seo.description,
  "areaServed": "Global"
};
---

<Layout
  title={data.seo.title}
  description={data.seo.description}
  seo={data.seo}
  image={data.hero.image}
  schema={serviceSchema}
  breadcrumbs={[
    { name: "Çözümler", url: "/cozumler" },
    { name: data.seo.breadcrumbName || "AI Destekli CX", url: "/cozumler/ai-destekli-cx" }
  ]}
>
  
  <!-- Header Banner -->
  <section class="bg-paletteRichBlack text-white px-6 md:px-16 py-24">
    <div class="max-w-custom mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 space-y-6">
        <div class="text-2xl sm:text-3xl font-normal tracking-tight text-white">
          {eyebrowTop || 'AI'} <span class="text-brandAccent font-serif font-light align-middle">*</span> {eyebrowBottom || 'EXPERIENCE'}
        </div>
        <HeroTag class="typo-h1 text-white">
          {data.hero.title}
        </HeroTag>
        <p class="typo-lead text-white/80 font-light max-w-2xl">
          {data.hero.desc}
        </p>
      </div>
      <div class="lg:col-span-5 aspect-square bg-neutral-900 overflow-hidden flex items-center justify-center relative">
        <img 
          src={data.hero.image} 
          alt={data.hero.imageAlt} 
          class="w-full h-full object-cover mix-blend-screen opacity-90 contrast-125"
        />
      </div>
    </div>
  </section>

  <!-- 4 Core Capabilities -->
  <section class="section-pad-150 bg-siteBg text-paletteRichBlack px-6 md:px-16">
    <div class="max-w-custom mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
        {data.capabilities.map((cap) => {
          const st = getSurfaceStyle(cap.style);
          const eyebrowColor = cap.style === 'platinum' ? 'text-brandAccent' : (cap.style === 'richBlack' ? 'text-brandAccent' : 'text-paletteRichBlack');
          const metricColor = cap.style === 'richBlack' ? 'text-brandAccent' : (cap.style === 'brandAccent' ? 'text-paletteRichBlack/70' : 'text-paletteRichBlack/60');
          return (
            <div class={`p-10 md:p-14 space-y-4 ${st.section}`}>
              <span class={`typo-small font-bold tracking-widest block ${eyebrowColor}`}>{cap.eyebrow}</span>
              <h2 class={`typo-h2 ${st.title}`}>{cap.title}</h2>
              <p class={`typo-body font-light ${st.body}`}>
                {cap.body}
              </p>
              <p class={`typo-small font-semibold tracking-widest pt-2 ${metricColor}`}>
                {cap.metric}
              </p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Metrics Bar -->
  <section class="bg-paletteRichBlack text-white px-6 md:px-16 py-20">
    <div class="max-w-custom mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {data.metrics.map((m) => (
        <div>
          <span class="text-4xl md:text-5xl font-light text-brandAccent block mb-2">{m.value}</span>
          <span class="typo-small font-medium tracking-wider text-white/60">{m.label}</span>
        </div>
      ))}
    </div>
  </section>

  <FAQSection items={data.faqs} title={data.faqTitle} />

  <CTASection title={data.cta.title} desc={data.cta.desc} />

</Layout>
