---
import Layout from '../../layouts/Layout.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTASection from '../../components/CTASection.astro';
import { getPages, getSite, getSurfaceStyle } from '../../lib/content';

const { deneyimTasarimi: data } = getPages();
const site = getSite();
const HeroTag = (['h1', 'h2', 'h3', 'h4'].includes(data.hero?.headingTag || '') ? data.hero.headingTag : 'h1') as 'h1' | 'h2' | 'h3' | 'h4';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": data.seo?.schemaType || "Service",
  "name": data.seo?.headline || "Müşteri Deneyimi Tasarımı & Saha Etnografisi",
  "provider": {
    "@type": "Organization",
    "name": site.brand.name,
    "url": site.brand.siteUrl
  },
  "serviceType": "Deneyim Tasarımı & Servis Blueprinting",
  "description": data.seo?.schemaDesc || data.seo.description,
  "areaServed": "Global"
};
---

<Layout
  title={data.seo.title}
  description={data.seo.description}
  seo={data.seo}
  image={data.hero.image}
  schema={serviceSchema}
  breadcrumbs={[
    { name: "Çözümler", url: "/cozumler" },
    { name: data.seo.breadcrumbName || "Deneyim Tasarımı", url: "/cozumler/deneyim-tasarimi" }
  ]}
>
  
  <section class="bg-siteBg text-paletteRichBlack px-6 md:px-16 py-24">
    <div class="max-w-custom mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 space-y-6">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 relative flex-shrink-0">
            <span class="absolute top-0 left-0 w-6 h-0.5 bg-paletteRichBlack"></span>
            <span class="absolute top-0 left-0 w-0.5 h-8 bg-paletteRichBlack"></span>
            <span class="absolute bottom-0 right-0 w-8 h-0.5 bg-paletteRichBlack"></span>
            <span class="absolute bottom-0 right-0 w-0.5 h-6 bg-paletteRichBlack"></span>
          </div>
          <span class="typo-small font-semibold tracking-widest text-paletteRichBlack/60">{data.hero.badge}</span>
        </div>
        <div class="text-5xl sm:text-7xl font-extralight tracking-tighter text-paletteRichBlack leading-none">
          {data.hero.bigWord}
        </div>
        <HeroTag class="typo-h1 text-paletteRichBlack">
          {data.hero.title}
        </HeroTag>
        <p class="typo-lead text-paletteRichBlack/75 font-light max-w-2xl">
          {data.hero.desc}
        </p>
      </div>
      <div class="lg:col-span-5 aspect-[4/3] bg-palettePlatinum overflow-hidden">
        <img 
          src={data.hero.image} 
          alt={data.hero.imageAlt} 
          class="w-full h-full object-cover grayscale contrast-125"
        />
      </div>
    </div>
  </section>

  <section class="section-pad-150 bg-palettePlatinum text-paletteRichBlack px-6 md:px-16">
    <div class="max-w-custom mx-auto grid grid-cols-1 md:grid-cols-2 gap-0">
      {data.capabilities.map((cap) => {
        const st = getSurfaceStyle(cap.style);
        const eyebrowColor = cap.style === 'siteBg' || cap.style === 'richBlack' ? 'text-brandAccent' : 'text-paletteRichBlack';
        return (
          <div class={`p-10 md:p-14 space-y-4 ${st.section}`}>
            <span class={`typo-small font-bold tracking-widest block ${eyebrowColor}`}>{cap.eyebrow}</span>
            <h2 class={`typo-h2 ${st.title}`}>{cap.title}</h2>
            <p class={`typo-body font-light ${st.body}`}>
              {cap.body}
            </p>
          </div>
        );
      })}
    </div>
  </section>

  <FAQSection items={data.faqs} title={data.faqTitle} />

  <CTASection title={data.cta.title} desc={data.cta.desc} />

</Layout>
