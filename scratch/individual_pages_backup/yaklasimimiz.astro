---
import Layout from '../layouts/Layout.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import { getPages } from '../lib/content';

const { yaklasimimiz: data } = getPages();
const manifestoData = data.manifesto || {
  title: "Kurumlar için en büyük risk, yapay zeka müşteri deneyimini kökten dönüştürürken insanı unutmaktır.",
  desc: "cx2222, yapay zekanın hızını ve analitik gücünü tasarımın derin empatisiyle dengeleyen bir müşteri deneyimi ve servis tasarımı şirketidir. Teknolojiyi amaç değil, insana değer üreten bir araç olarak konumlandırıyoruz.",
  items: [
    {
      id: "empati-ve-insan-sezgisi",
      title: "Empati ve İnsan Sezgisi",
      tagline: "Verinin kalbi duygudur, algoritmanın kalbi ise empati.",
      p1: "Rakamlar müşterinin ne yaptığını milisaniyeler içinde gösterir; ancak derin etnografik dinleme ve insan sezgisi neden yaptığını ortaya çıkarır.",
      p2: "Günün sonunda satın alma kararı veren, markaya bağlanan veya öfkeyle ayrılan varlık insandır. Algoritmaların göremediği söylenmemiş ihtiyaçları sahadaki sezgiyle yakalıyoruz."
    },
    {
      id: "etik-ve-dengeli-yapay-zeka",
      title: "Etik & Dengeli Yapay Zeka",
      tagline: "Rutin operasyonlar yapay zekaya, samimi şefkat insana aittir.",
      p1: "Yapay zeka tekrarlayan işleri hızlandırmak, işlem anomalilerini önceden yakalamak ve kesintisiz ölçeklenmek için mükemmel bir güçtür.",
      p2: "Ancak kriz, mağduriyet ve güven tesis etme anlarında müşterinin aradığı şey gerçek bir insani anlayıştır. Doğru dönüşüm, bu iki gücün kusursuz uyumundan doğar."
    },
    {
      id: "ex-olmadan-cx-olmaz",
      title: "EX Olmadan CX Olmaz",
      tagline: "Mutsuz bir çalışanın müşteriyi mutlu etmesi imkansızdır.",
      p1: "Çalışan Deneyimi (EX) ile Müşteri Deneyimi (CX) birbirini besleyen tek bir yaşayan organizmadır.",
      p2: "Ön hat çalışanlarınıza yetki vermeden, bürokratik engelleri kaldırmadan ve kurumiçi empatiyi inşa etmeden kalıcı bir müşteri deneyimi yaratılamaz."
    },
    {
      id: "surekli-yasayan-kultur",
      title: "Sürekli Yaşayan Kültür",
      tagline: "Dönüşüm bir proje değil, kurum DNA'sına işleyen bir yolculuktur.",
      p1: "Teorik danışmanlık raporları ve slayt sunumları çekmecelerde unutulmaya mahkumdur.",
      p2: "Biz kurumiçi elçiler yetiştirir, ekipleri sahada bizzat yetkinleştirir ve deneyim odaklı düşünmeyi şirketin kalıcı refleksine dönüştürürüz."
    }
  ]
};
---

<Layout
  title={data.seo.title}
  description={data.seo.description}
  seo={data.seo}
  breadcrumbs={[
    { name: data.seo.breadcrumbName || "Yaklaşımımız", url: "/yaklasimimiz" }
  ]}
>
  
  <!-- Main Approach & Manifesto Section -->
  <section class="bg-siteBg text-paletteRichBlack px-6 md:px-16 pt-8 md:pt-16 pb-20 md:pb-28">
    <div class="max-w-custom mx-auto">
      
      <!-- Primary Tabs Switcher: Yaklaşımımız vs Manifestomuz -->
      <div 
        class="inline-flex items-center p-1 sm:p-1.5 bg-palettePlatinum border border-paletteDustGrey mb-12 sm:mb-16 max-w-full"
        role="tablist"
        aria-label="Yaklaşımımız ve Manifestomuz Sekmeleri"
      >
        <button
          type="button"
          id="tab-btn-yaklasim"
          role="tab"
          aria-selected="true"
          aria-controls="panel-yaklasim"
          class="tab-btn-primary px-4 sm:px-6 lg:px-7 py-2 sm:py-2.5 text-sm sm:text-base lg:text-lg font-normal tracking-normal transition-all cursor-pointer bg-paletteRichBlack text-white"
        >
          Yaklaşımımız
        </button>
        <button
          type="button"
          id="tab-btn-manifesto"
          role="tab"
          aria-selected="false"
          aria-controls="panel-manifesto"
          class="tab-btn-primary px-4 sm:px-6 lg:px-7 py-2 sm:py-2.5 text-sm sm:text-base lg:text-lg font-normal tracking-normal transition-all cursor-pointer bg-transparent text-paletteRichBlack/60 hover:text-brandAccent hover:bg-white"
        >
          Manifestomuz
        </button>
      </div>

      <!-- TAB PANEL 1: YAKLAŞIMIMIZ (4 TEMEL PRENSİP) -->
      <div 
        id="panel-yaklasim" 
        role="tabpanel" 
        aria-labelledby="tab-btn-yaklasim"
        class="tab-panel-main block"
      >
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
          
          <!-- Left Column: Sticky Subtitle & Description -->
          <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-32">
            <span class="typo-small font-semibold tracking-widest text-brandAccent block">
              Yaklaşımımız
            </span>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-light text-paletteRichBlack leading-snug">
              {data.hero.title}
            </h1>
            <p class="typo-lead text-paletteRichBlack/75 font-light leading-relaxed">
              {data.hero.desc}
            </p>
            <div class="pt-2">
              <a 
                href="/iletisim" 
                class="inline-flex items-center gap-2 font-medium text-paletteRichBlack hover:text-brandAccent underline underline-offset-8 transition-colors"
              >
                Görüşelim →
              </a>
            </div>
          </div>

          <!-- Right Column: 01 / PRENSİP .. 04 / PRENSİP with SVG Icons -->
          <div class="lg:col-span-8 space-y-16 sm:space-y-20">
            {data.pillars.map((item, idx) => (
              <article 
                id={item.id}
                class="group flex flex-col sm:flex-row items-start gap-6 sm:gap-10 pb-12 sm:pb-16 border-b border-paletteDustGrey/60 last:border-b-0 last:pb-0 scroll-mt-28"
              >
                <!-- SVG Icon Circle Badge -->
                <div class="w-20 h-20 sm:w-24 sm:h-24 md:w-28 md:h-28 rounded-full bg-palettePlatinum flex-shrink-0 flex items-center justify-center transition-colors group-hover:bg-brandAccent/15">
                  {idx === 0 && (
                    <svg class="w-10 h-10 sm:w-12 sm:h-12 text-paletteRichBlack group-hover:text-brandAccent transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                      <circle cx="9" cy="7" r="4"/>
                      <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                      <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                  )}
                  {idx === 1 && (
                    <svg class="w-10 h-10 sm:w-12 sm:h-12 text-paletteRichBlack group-hover:text-brandAccent transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polygon points="12 2 14.5 9.5 22 12 14.5 14.5 12 22 9.5 14.5 2 12 9.5 9.5 12 2"/>
                      <circle cx="12" cy="12" r="2"/>
                    </svg>
                  )}
                  {idx === 2 && (
                    <svg class="w-10 h-10 sm:w-12 sm:h-12 text-paletteRichBlack group-hover:text-brandAccent transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M4.93 4.93a10 10 0 0 1 14.14 0"/>
                      <path d="M7.76 7.76a6 6 0 0 1 8.48 0"/>
                      <circle cx="12" cy="12" r="2"/>
                      <path d="M12 12v9"/>
                    </svg>
                  )}
                  {idx === 3 && (
                    <svg class="w-10 h-10 sm:w-12 sm:h-12 text-paletteRichBlack group-hover:text-brandAccent transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="8.5" cy="12" r="5.5"/>
                      <circle cx="15.5" cy="12" r="5.5"/>
                      <path d="M12 8.5v7" stroke-dasharray="1 1.5"/>
                    </svg>
                  )}
                </div>

                <!-- Text Content -->
                <div class="space-y-3 flex-1 min-w-0">
                  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-light text-paletteRichBlack tracking-tight leading-tight">
                    {item.title}
                  </h2>
                  <p class="typo-lead font-medium text-paletteRichBlack italic pt-1 pb-2">
                    "{item.tagline}"
                  </p>
                  <p class="typo-body text-paletteRichBlack/80 font-light leading-relaxed">
                    {item.p1}
                  </p>
                  <p class="typo-body text-paletteRichBlack/80 font-light leading-relaxed">
                    {item.p2}
                  </p>
                </div>
              </article>
            ))}
          </div>

        </div>
      </div>

      <!-- TAB PANEL 2: MANİFESTOMUZ -->
      <div 
        id="panel-manifesto" 
        role="tabpanel" 
        aria-labelledby="tab-btn-manifesto"
        class="tab-panel-main hidden"
      >
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
          
          <!-- Left Column: Sticky Subtitle & Description -->
          <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-32">
            <span class="typo-small font-semibold tracking-widest text-brandAccent block">
              Manifestomuz
            </span>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-light text-paletteRichBlack leading-snug">
              {manifestoData.title}
            </h2>
            <p class="typo-lead text-paletteRichBlack/75 font-light leading-relaxed">
              {manifestoData.desc}
            </p>
            <div class="pt-2">
              <a 
                href="/iletisim" 
                class="inline-flex items-center gap-2 font-medium text-paletteRichBlack hover:text-brandAccent underline underline-offset-8 transition-colors"
              >
                Görüşelim →
              </a>
            </div>
          </div>

          <!-- Right Column: 01 / İLKE .. 04 / İLKE with SVG Icons -->
          <div class="lg:col-span-8 space-y-16 sm:space-y-20">
            {manifestoData.items.map((item, idx) => (
              <article 
                id={item.id}
                class="group flex flex-col sm:flex-row items-start gap-6 sm:gap-10 pb-12 sm:pb-16 border-b border-paletteDustGrey/60 last:border-b-0 last:pb-0 scroll-mt-28"
              >
                <!-- SVG Icon Circle Badge -->
                <div class="w-20 h-20 sm:w-24 sm:h-24 md:w-28 md:h-28 rounded-full bg-palettePlatinum flex-shrink-0 flex items-center justify-center transition-colors group-hover:bg-brandAccent/15">
                  {idx === 0 && (
                    <svg class="w-10 h-10 sm:w-12 sm:h-12 text-paletteRichBlack group-hover:text-brandAccent transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                      <circle cx="12" cy="11" r="2.5"/>
                    </svg>
                  )}
                  {idx === 1 && (
                    <svg class="w-10 h-10 sm:w-12 sm:h-12 text-paletteRichBlack group-hover:text-brandAccent transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="4" y="4" width="16" height="16" rx="2"/>
                      <circle cx="12" cy="12" r="3"/>
                      <path d="M12 2v2M12 20v2M2 12h2M20 12h2"/>
                    </svg>
                  )}
                  {idx === 2 && (
                    <svg class="w-10 h-10 sm:w-12 sm:h-12 text-paletteRichBlack group-hover:text-brandAccent transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m11 17 2 2a1 1 0 0 0 1.4 0l6.6-6.6a1 1 0 0 0 0-1.4l-2-2a1 1 0 0 0-1.4 0L11 15.6"/>
                      <path d="m13 7-2-2a1 1 0 0 0-1.4 0L3 11.6a1 1 0 0 0 0 1.4l2 2a1 1 0 0 0 1.4 0L13 8.4"/>
                    </svg>
                  )}
                  {idx === 3 && (
                    <svg class="w-10 h-10 sm:w-12 sm:h-12 text-paletteRichBlack group-hover:text-brandAccent transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
                    </svg>
                  )}
                </div>

                <!-- Text Content -->
                <div class="space-y-3 flex-1 min-w-0">
                  <h3 class="text-2xl sm:text-3xl lg:text-4xl font-light text-paletteRichBlack tracking-tight leading-tight">
                    {item.title}
                  </h3>
                  <p class="typo-lead font-medium text-paletteRichBlack italic pt-1 pb-2">
                    "{item.tagline}"
                  </p>
                  <p class="typo-body text-paletteRichBlack/80 font-light leading-relaxed">
                    {item.p1}
                  </p>
                  <p class="typo-body text-paletteRichBlack/80 font-light leading-relaxed">
                    {item.p2}
                  </p>
                </div>
              </article>
            ))}
          </div>

        </div>
      </div>

    </div>
  </section>

  <FAQSection items={data.faqs} title={data.faqTitle} subtitle={data.faqSubtitle} />

  <CTASection />

</Layout>

<script>
  function setupTabs() {
    const yaklasimBtn = document.getElementById('tab-btn-yaklasim');
    const manifestoBtn = document.getElementById('tab-btn-manifesto');
    const yaklasimPanel = document.getElementById('panel-yaklasim');
    const manifestoPanel = document.getElementById('panel-manifesto');

    if (!yaklasimBtn || !manifestoBtn || !yaklasimPanel || !manifestoPanel) return;

    const activeTabClass = 'tab-btn-primary px-4 sm:px-6 lg:px-7 py-2 sm:py-2.5 text-sm sm:text-base lg:text-lg font-normal tracking-normal transition-all cursor-pointer bg-paletteRichBlack text-white';
    const inactiveTabClass = 'tab-btn-primary px-4 sm:px-6 lg:px-7 py-2 sm:py-2.5 text-sm sm:text-base lg:text-lg font-normal tracking-normal transition-all cursor-pointer bg-transparent text-paletteRichBlack/60 hover:text-brandAccent hover:bg-white';

    function switchPrimaryTab(activeTab: 'yaklasim' | 'manifesto', updateHash = true) {
      if (activeTab === 'yaklasim') {
        yaklasimBtn.setAttribute('aria-selected', 'true');
        yaklasimBtn.className = activeTabClass;

        manifestoBtn.setAttribute('aria-selected', 'false');
        manifestoBtn.className = inactiveTabClass;

        yaklasimPanel.classList.remove('hidden');
        yaklasimPanel.classList.add('block');
        manifestoPanel.classList.add('hidden');
        manifestoPanel.classList.remove('block');

        if (updateHash && window.location.hash.includes('manifesto')) {
          history.replaceState(null, '', window.location.pathname + '#yaklasimimiz');
        }
      } else {
        manifestoBtn.setAttribute('aria-selected', 'true');
        manifestoBtn.className = activeTabClass;

        yaklasimBtn.setAttribute('aria-selected', 'false');
        yaklasimBtn.className = inactiveTabClass;

        manifestoPanel.classList.remove('hidden');
        manifestoPanel.classList.add('block');
        yaklasimPanel.classList.add('hidden');
        yaklasimPanel.classList.remove('block');

        if (updateHash) {
          history.replaceState(null, '', window.location.pathname + '#manifestomuz');
        }
      }
    }

    yaklasimBtn.addEventListener('click', () => switchPrimaryTab('yaklasim'));
    manifestoBtn.addEventListener('click', () => switchPrimaryTab('manifesto'));

    // Handle hash on initial load
    const hash = window.location.hash.toLowerCase().replace('#', '');
    if (hash === 'manifesto' || hash === 'manifestomuz') {
      switchPrimaryTab('manifesto', false);
    } else if (hash) {
      const targetElem = document.getElementById(hash);
      if (targetElem) {
        if (yaklasimPanel.contains(targetElem)) {
          switchPrimaryTab('yaklasim', false);
        } else if (manifestoPanel.contains(targetElem)) {
          switchPrimaryTab('manifesto', false);
        }
        setTimeout(() => {
          targetElem.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 100);
      }
    }
  }

  setupTabs();
  document.addEventListener('astro:page-load', setupTabs);
</script>
