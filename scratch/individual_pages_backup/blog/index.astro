---
import Layout from '../../layouts/Layout.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTASection from '../../components/CTASection.astro';
import { getAllPosts, getPages, getBarClass } from '../../lib/content';

const { blogIndex: data } = getPages() as any;
const articles = getAllPosts();
const HeroTag = (['h1', 'h2', 'h3', 'h4'].includes(data.hero?.headingTag || '') ? data.hero.headingTag : 'h1') as 'h1' | 'h2' | 'h3' | 'h4';
---

<Layout
  title={data.seo.title}
  description={data.seo.description}
  seo={data.seo}
  image={data.hero.bgImage}
  breadcrumbs={[
    { name: data.seo.breadcrumbName || "Blog", url: "/blog" }
  ]}
>
  
  <section class="relative bg-palettePlatinum text-paletteRichBlack px-6 md:px-16 py-24 overflow-hidden">
    <div class="absolute inset-0 w-full h-full pointer-events-none z-0">
      <img 
        src={data.hero.bgImage} 
        alt={data.hero.bgAlt} 
        class="w-full h-full object-cover object-center opacity-10 filter contrast-125"
      />
    </div>
    <div class="relative z-10 max-w-custom mx-auto max-w-4xl space-y-6">
      <span class="typo-small font-semibold tracking-widest text-paletteRichBlack/60 block">{data.hero.eyebrow}</span>
      <HeroTag class="typo-h1 text-paletteRichBlack">
        {data.hero.title}
      </HeroTag>
      <p class="typo-lead text-paletteRichBlack/75 font-light max-w-2xl">
        {data.hero.desc}
      </p>
    </div>
  </section>

  <!-- Articles List matching cx2222 tasarım referansı exact signature card style -->
  <section class="section-pad-150 bg-palettePlatinum/50 text-paletteRichBlack px-6 md:px-16">
    <div class="max-w-custom mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      
      {articles.map((art) => (
        <a 
          href={`/blog/${art.slug}`}
          class="flex flex-col md:flex-row items-stretch group cursor-pointer bg-siteBg transition-all overflow-hidden md:min-h-[260px]"
        >
          <div class={`h-3 w-full md:h-auto md:w-5 flex-shrink-0 transition-colors ${getBarClass(art.barStyle)}`}></div>

          <div class="p-6 sm:p-8 flex-grow min-w-0 flex flex-col justify-between space-y-6">
            <div class="space-y-3">
              <div class="flex items-center gap-3 typo-small text-paletteRichBlack/50 tracking-wider font-medium">
                <span>{art.category}</span>
                <span>•</span>
                <span>{art.readTime}</span>
              </div>
              <h2 class="typo-h3 text-paletteRichBlack group-hover:text-brandAccent transition-colors">
                {art.title}
              </h2>
              <p class="typo-body text-paletteRichBlack/70 font-light">
                {art.desc}
              </p>
            </div>

            <div class="pt-4 mt-auto flex items-center justify-between">
              <span class="font-semibold text-paletteRichBlack group-hover:text-brandAccent transition-colors inline-flex items-center space-x-1.5">
                <span>{data.readMoreText || 'Devamını Oku →'}</span>
              </span>
              <span class="typo-small text-paletteRichBlack/40">{art.date}</span>
            </div>
          </div>

          <div class="w-full h-52 md:w-44 md:h-auto md:self-stretch flex-shrink-0 overflow-hidden relative p-0 m-0 bg-neutral-100">
            <img 
              src={art.image} 
              alt={art.imageAlt || art.title} 
              class="w-full h-full object-cover object-center grayscale contrast-125 group-hover:scale-105 transition-transform duration-500"
            />
          </div>
        </a>
      ))}

    </div>
  </section>

  {data.faqs && data.faqs.length > 0 && (
    <FAQSection items={data.faqs} title={data.faqTitle || 'Blog Hakkında Sıkça Sorulanlar'} />
  )}

  <CTASection />

</Layout>
