---
import Layout from '../layouts/Layout.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import { getPages } from '../lib/content';

const { nedenSimdi: data } = getPages();
const HeroTag = (['h1', 'h2', 'h3', 'h4'].includes(data.hero?.headingTag || '') ? data.hero.headingTag : 'h1') as 'h1' | 'h2' | 'h3' | 'h4';
---

<Layout
  title={data.seo.title}
  description={data.seo.description}
  seo={data.seo}
  breadcrumbs={[
    { name: data.seo.breadcrumbName || "Neden Şimdi?", url: "/neden-simdi" }
  ]}
>
  
  <section class="relative bg-palettePlatinum text-paletteRichBlack px-6 md:px-16 py-24 overflow-hidden">
    <div class="absolute inset-0 w-full h-full pointer-events-none z-0">
      <img src={data.hero.bgImage} alt={data.hero.bgAlt} class="w-full h-full object-cover object-center opacity-10 grayscale" />
    </div>
    <div class="relative z-10 max-w-custom mx-auto max-w-3xl space-y-6">
      <span class="typo-small font-semibold tracking-widest text-paletteRichBlack/60 block">{data.hero.eyebrow}</span>
      <HeroTag class="typo-h1 text-paletteRichBlack">
        {data.hero.title}
      </HeroTag>
      <p class="typo-lead text-paletteRichBlack/75 font-light">
        {data.hero.desc}
      </p>
    </div>
  </section>

  <!-- The 4 Shifts -->
  <section class="section-pad-150 bg-siteBg text-paletteRichBlack px-6 md:px-16">
    <div class="max-w-custom mx-auto space-y-24">
      
      {data.shifts.map((s) => (
        <div id={s.id} class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch">
          
          <div class="lg:col-span-4 space-y-4 flex flex-col justify-between bg-paletteDustGrey p-8 md:p-10">
            <div>
              <span class="text-3xl font-light text-paletteRichBlack/50 block mb-2">{s.number}</span>
              <h2 class="typo-h2 text-paletteRichBlack mb-2">{s.title}</h2>
              <p class="typo-small font-semibold tracking-widest text-paletteRichBlack/60">{s.sub}</p>
            </div>
            <div class="w-full aspect-[16/9] bg-neutral-200 overflow-hidden mt-6">
              <img src={s.image} alt={s.title} class="w-full h-full object-cover grayscale contrast-125" />
            </div>
          </div>

          <div class="lg:col-span-8 grid grid-cols-1 md:grid-cols-2 gap-0">
            <div class="p-8 md:p-12 bg-palettePlatinum flex flex-col justify-center space-y-4">
              <span class="typo-small font-bold tracking-widest text-paletteRichBlack/50 block">Eski Modelin Çıkmazı</span>
              <p class="typo-lead text-paletteRichBlack/80 font-light">
                {s.problem}
              </p>
            </div>
            <div class="p-8 md:p-12 bg-paletteRichBlack text-white flex flex-col justify-center space-y-4">
              <span class="typo-small font-bold tracking-widest text-brandAccent block">cx2222 Çözümü</span>
              <p class="typo-lead text-white/85 font-light">
                {s.solution}
              </p>
            </div>
          </div>

        </div>
      ))}

    </div>
  </section>

  <FAQSection items={data.faqs} title={data.faqTitle} subtitle={data.faqSubtitle} />

  <CTASection title={data.cta.title} desc={data.cta.desc} />

</Layout>
