---
import Layout from '../layouts/Layout.astro';
import { getPages } from '../lib/content';

const { notFound: data } = getPages();
const HeroTag = (['h1', 'h2', 'h3', 'h4'].includes(data.headingTag || '') ? data.headingTag : 'h1') as 'h1' | 'h2' | 'h3' | 'h4';
---

<Layout
  title={data.seo.title}
  description={data.seo.description}
  seo={data.seo}
  defaultRobots="noindex, nofollow"
>
  <section class="section-pad-150 bg-palettePlatinum text-paletteRichBlack px-6 md:px-16">
    <div class="max-w-custom mx-auto max-w-2xl space-y-6">
      <span class="typo-small font-semibold tracking-widest text-brandAccent bg-paletteRichBlack px-3 py-1 inline-block">{data.badge}</span>
      <HeroTag class="typo-h1 text-paletteRichBlack">
        {data.title}
      </HeroTag>
      <p class="typo-lead text-paletteRichBlack/75 font-light">
        {data.desc}
      </p>
      <div class="pt-6 flex flex-wrap items-center gap-4">
        <a 
          href={data.primaryBtnHref} 
          class="btn-rect px-8 py-3.5 bg-paletteRichBlack text-white hover:bg-paletteDeepNavy font-light"
        >
          {data.primaryBtnLabel}
        </a>
        <a 
          href={data.secondaryBtnHref} 
          class="btn-rect px-6 py-3.5 bg-brandAccent text-paletteRichBlack hover:bg-brandAccentHover font-semibold"
        >
          {data.secondaryBtnLabel}
        </a>
      </div>
    </div>
  </section>
</Layout>
